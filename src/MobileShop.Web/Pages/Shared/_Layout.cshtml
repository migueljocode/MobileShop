<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MobileShop.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navigation-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MobileShop.Web.styles.css" asp-append-version="true" />
</head>
<body class="has-floating-navigation">
    <div class="container">
        <main role="main" class="mt-3 pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MobileShop.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @await Component.InvokeAsync("NavigationMenu")
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navigation-menu.js" asp-append-version="true"></script>
    <script src="~/js/person-picker.js" asp-append-version="true"></script>
    <script src="~/js/jalali-datepicker.js" asp-append-version="true"></script>
</body>
</html>
