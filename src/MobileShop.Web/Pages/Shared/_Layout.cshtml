<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <script>try{if(localStorage.getItem('mobileshop.surfaces')==='solid')document.documentElement.setAttribute('data-surfaces','solid');}catch(e){}</script>
    <script>try{var t=localStorage.getItem('mobileshop.theme');if(t==='light'){document.documentElement.setAttribute('data-theme','light');document.documentElement.setAttribute('data-bs-theme','light');}}catch(e){}</script>
    <meta name="theme-color" content="#0E1318" />
    <title>@ViewData["Title"] - MobileShop</title>
    <script type="importmap"></script>
    <link rel="preload" href="~/fonts/sf-pro-rounded-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/sf-pro-rounded-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/surfaces.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/overlays.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navigation-menu.css" asp-append-version="true" />
</head>
<body class="has-floating-navigation">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="container">
        <main id="main" role="main" tabindex="-1" class="mt-3 pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 MobileShop - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @await Component.InvokeAsync("NavigationMenu")
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/combobox.js" asp-append-version="true"></script>
    <script src="~/js/navigation-menu.js" asp-append-version="true"></script>
    <script src="~/js/person-picker.js" asp-append-version="true"></script>
    <script src="~/js/jalali-datepicker.js" asp-append-version="true"></script>
</body>
</html>
