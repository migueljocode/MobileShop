@model MobileShop.Models.ViewModels.Web.BindModels.CreateCaseInputModel
@{
    var manufacturers = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Manufacturers"]!;
    var compatibleModels = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["CompatibleModels"]!;
}
<div class="row g-3" data-create-product-type="case">
    <div class="form-section col-12">
        <h2 class="form-section__title">Product</h2>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Case manufacturer</label><select name="input.ManufacturerId" class="form-select"><option value="">-- Select manufacturer --</option>@foreach (var option in manufacturers) { <option value="@option.Id">@option.Name</option> }</select></div>
            <div class="col-md-6"><label class="form-label">Compatible phone manufacturer</label><select name="input.CompatibleManufacturerId" class="form-select" data-case-compatible-manufacturer><option value="">-- Select manufacturer --</option>@foreach (var option in manufacturers) { <option value="@option.Id">@option.Name</option> }</select></div>
            <div class="col-12"><label class="form-label">Compatible phone models</label><select name="input.CompatibleModelIds" class="form-select" multiple size="5" data-case-compatible-models>@foreach (var option in compatibleModels) { <option value="@option.Id">@option.Name</option> }</select></div>
        </div>
    </div>
    <div class="form-section col-12">
        <h2 class="form-section__title">Pricing</h2>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">Paid price (Toman)</label><input name="input.Price" class="form-control" inputmode="numeric" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" value="@Model.Price" /></div>
            <div class="col-md-4"><label class="form-label">Profit %</label><input name="input.ProfitPercent" class="form-control" type="number" step="0.01" min="0" value="@Model.ProfitPercent" /></div>
            <div class="col-md-4"><label class="form-label">Profit amount (Toman)</label><input name="input.ProfitAmount" class="form-control" inputmode="numeric" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" value="@Model.ProfitAmount" /></div>
        </div>
    </div>
    <div class="form-section col-12">
        <h2 class="form-section__title">Case details</h2>
        <div class="row g-3">
            <div class="col-12"><label class="form-label">Count</label><input name="input.Count" class="form-control" type="number" min="1" value="@Model.Count" /></div>
        </div>
    </div>
</div>