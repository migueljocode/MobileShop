@model MobileShop.Models.ViewModels.Web.BindModels.CreatePhoneInputModel
@{
    var manufacturers = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Manufacturers"]!;
    var models = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Models"]!;
    var colors = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Colors"]!;
    var partNumbers = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["PartNumbers"]!;
    var corporations = (IReadOnlyList<string>)ViewData["Corporations"]!;
}
<div class="row g-3" data-create-product-type="phone">
    <div class="col-md-6"><label class="form-label">Manufacturer</label><select name="input.ManufacturerId" class="form-select" data-phone-manufacturer><option value="">-- Select manufacturer --</option>@foreach (var option in manufacturers) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-6"><label class="form-label">Model</label><select name="input.ModelId" class="form-select" data-phone-model><option value="">-- Select model --</option>@foreach (var option in models) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-4"><label class="form-label">Paid price (IRR)</label><input name="input.Price" class="form-control" inputmode="numeric" min="0" value="@Model.Price" /></div>
    <div class="col-md-4"><label class="form-label">Profit %</label><input name="input.ProfitPercent" class="form-control" type="number" step="0.01" min="0" value="@Model.ProfitPercent" /></div>
    <div class="col-md-4"><label class="form-label">Profit amount (IRR)</label><input name="input.ProfitAmount" class="form-control" inputmode="numeric" min="0" value="@Model.ProfitAmount" /></div>
    <div class="col-md-6"><label class="form-label">IMEI 1</label><input name="input.IMEI1" class="form-control" maxlength="15" inputmode="numeric" value="@Model.IMEI1" /></div>
    <div class="col-md-6"><label class="form-label">IMEI 2</label><input name="input.IMEI2" class="form-control" maxlength="15" inputmode="numeric" value="@Model.IMEI2" /></div>
    <div class="col-md-6"><label class="form-label">Color</label><select name="input.ColorId" class="form-select"><option value="">-- Optional --</option>@foreach (var option in colors) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-6"><label class="form-label">Part number</label><select name="input.PartNumberId" class="form-select"><option value="">-- Optional --</option>@foreach (var option in partNumbers) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-12"><div class="form-check"><input name="input.IsSecondHand" value="true" type="checkbox" class="form-check-input" /><label class="form-check-label">Second-hand item</label></div></div>
    <div class="col-md-6"><label class="form-label">Second-hand test days</label><input name="input.TestPeriodDays" class="form-control" type="number" min="0" /></div>
    <div class="col-md-6"><label class="form-label">Second-hand notes</label><input name="input.SecondHandNotes" class="form-control" maxlength="500" /></div>
    <div class="col-12"><div class="form-check"><input name="input.HasGuarantee" value="true" type="checkbox" class="form-check-input" /><label class="form-check-label">Has guarantee</label></div></div>
    <div class="col-md-6"><label class="form-label">Guarantee corporation</label><select name="input.GuaranteeCorporation" class="form-select"><option value="">Shop Warranty</option>@foreach (var corporation in corporations) { <option value="@corporation">@corporation</option> }</select></div>
    <div class="col-md-6"><label class="form-label">Guarantee expiry</label><input name="input.GuaranteeExpiry" class="form-control" type="date" /></div>
    <div class="col-12"><label class="form-label">Guarantee notes</label><input name="input.GuaranteeNotes" class="form-control" maxlength="500" /></div>
</div>