@model MobileShop.Models.ViewModels.Web.BindModels.CreateGlassInputModel
@{
    var manufacturers = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Manufacturers"]!;
    var models = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Models"]!;
}
<div class="row g-3" data-create-product-type="glass">
    <div class="form-section col-12">
        <h2 class="form-section__title">Product</h2>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Compatible phone manufacturer</label><select name="input.CompatibleManufacturerId" class="form-select" data-glass-compatible-manufacturer><option value="">-- Select manufacturer --</option>@foreach (var option in manufacturers) { <option value="@option.Id">@option.Name</option> }</select></div>
            <div class="col-md-6"><label class="form-label">Compatible phone model</label><select name="input.CompatibleModelId" class="form-select" data-glass-compatible-model><option value="">-- Select model --</option>@foreach (var option in models) { <option value="@option.Id">@option.Name</option> }</select></div>
            <div class="col-md-6"><label class="form-label">Glass manufacturer</label><select name="input.GlassManufacturerId" class="form-select"><option value="">-- Select manufacturer --</option>@foreach (var option in manufacturers) { <option value="@option.Id">@option.Name</option> }</select></div>
        </div>
    </div>
    <div class="form-section col-12">
        <h2 class="form-section__title">Pricing</h2>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">Paid price (Toman)</label><input name="input.Price" class="form-control" inputmode="numeric" min="0" value="@Model.Price" /></div>
            <div class="col-md-4"><label class="form-label">Profit %</label><input name="input.ProfitPercent" class="form-control" type="number" step="0.01" min="0" value="@Model.ProfitPercent" /></div>
            <div class="col-md-4"><label class="form-label">Profit amount (Toman)</label><input name="input.ProfitAmount" class="form-control" inputmode="numeric" min="0" value="@Model.ProfitAmount" /></div>
        </div>
    </div>
    <div class="form-section col-12">
        <h2 class="form-section__title">Details</h2>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">Count</label><input name="input.Count" class="form-control" type="number" min="1" value="@Model.Count" /></div>
        </div>
    </div>
</div>
