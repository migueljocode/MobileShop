@model IReadOnlyList<PartyOptionViewModel>
@{
    var role = ViewData["PersonPickerRole"]?.ToString() ?? "customer";
    var isCustomer = role == "customer";
    var label = isCustomer ? "Customer" : "Seller";
    var fieldName = isCustomer ? "Input.CustomerId" : "Input.SellerId";
    var fieldId = isCustomer ? "Input_CustomerId" : "Input_SellerId";
    var pickerId = role + "-person-picker";
    var resultsId = pickerId + "-results";
    var searchHandler = isCustomer ? "SearchCustomers" : "SearchSellers";
    var createHandler = isCustomer ? "CreateCustomer" : "CreateSeller";
    var endpoint = ViewData["PersonPickerEndpoint"]?.ToString();
    var modalId = role + "-create-person-modal";
    var modalLabelId = modalId + "-label";
}
<div class="mb-3" data-person-picker data-person-role="@role" data-search-handler="@searchHandler" data-create-handler="@createHandler" data-person-endpoint="@endpoint">
    <label for="@pickerId" class="form-label mt-2 mb-1">@label</label>
    <input type="hidden" name="@fieldName" id="@fieldId" value="@(ViewData.ModelState[$"{fieldName}"]?.AttemptedValue ?? "0")" data-person-value />
    <div class="input-group">
        <div class="person-picker__field">
            <input id="@pickerId" type="text" class="form-control" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="@resultsId" aria-expanded="false" placeholder="Search by name@(isCustomer ? ", phone or national code" : " or phone")" data-person-search />
            <div id="@resultsId" class="list-group d-none" role="listbox" data-person-results>
                @foreach (var person in Model)
                {
                    <button type="button" class="list-group-item list-group-item-action" role="option" dir="auto" data-person-id="@person.Id">@person.Label@(string.IsNullOrWhiteSpace(person.TypeLabel) ? string.Empty : $" ({person.TypeLabel})")</button>
                }
            </div>
        </div>
        <button type="button" class="btn btn-outline-secondary input-group-add-icon" data-person-create aria-controls="@modalId" aria-label="Create new @label" title="Create new @label"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.25v9.5M3.25 8h9.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
    </div>
    <span class="text-danger" data-person-error></span>
    @Html.ValidationMessage(fieldName, string.Empty, new { @class = "text-danger" })
    @Html.ValidationMessage(isCustomer ? "CustomerId" : "SellerId", string.Empty, new { @class = "text-danger" })

    <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@modalLabelId" aria-hidden="true" data-person-modal>
        <div class="modal-dialog">
            <div class="modal-content modal-content--solid">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="@modalLabelId">Create @label.ToLowerInvariant()</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" data-person-modal-error role="alert"></div>
                    <div class="mb-3">
                        <label class="form-label" for="@($"{role}-first-name")">First name</label>
                        <input id="@($"{role}-first-name")" class="form-control" name="FirstName" maxlength="50" required data-person-field="FirstName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="@($"{role}-last-name")">Last name</label>
                        <input id="@($"{role}-last-name")" class="form-control" name="LastName" maxlength="50" required data-person-field="LastName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="@($"{role}-phone")">Phone</label>
                        <input id="@($"{role}-phone")" class="form-control" name="PhoneNumber" maxlength="20" required data-person-field="PhoneNumber" />
                    </div>
                    @if (isCustomer)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="customer-national-id">National ID</label>
                            <input id="customer-national-id" class="form-control" name="NationalId" maxlength="10" required data-person-field="NationalId" />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label" for="seller-entity-type">Entity type</label>
                            <select id="seller-entity-type" class="form-select" name="EntityType" data-person-field="EntityType">
                                <option value="0">Real</option>
                                <option value="1">Legal</option>
                            </select>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label" for="@($"{role}-notes")">Notes</label>
                        <textarea id="@($"{role}-notes")" class="form-control" name="Notes" maxlength="500" data-person-field="Notes"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" data-person-save>Create @label.ToLowerInvariant()</button>
                </div>
            </div>
        </div>
    </div>
</div>
