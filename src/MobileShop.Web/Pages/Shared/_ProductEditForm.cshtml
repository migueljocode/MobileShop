@model MobileShop.Web.Pages.Products.EditModel

@if (Model.Product.Type == "Phone")
{
    <div class="col-md-6">
        <label asp-for="Product.ColorId" class="form-label">Color</label>
        <div class="input-group">
            <select asp-for="Product.ColorId" asp-items="@(new SelectList(Model.Colors, "Id", "Name"))" class="form-select" id="colorSelect">
                <option value="">-- Select color --</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addColorModal" id="addColorBtn">Add New</button>
        </div>
        <span asp-validation-for="Product.ColorId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Product.PartNumberId" class="form-label">Part number</label>
        <div class="input-group">
            <select asp-for="Product.PartNumberId" asp-items="@(new SelectList(Model.PartNumbers, "Id", "Name"))" class="form-select" id="partNumberSelect">
                <option value="">-- Select part number --</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addPartNumberModal">Add New</button>
        </div>
        <span asp-validation-for="Product.PartNumberId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Product.IMEI1" class="form-label">IMEI 1</label>
        <input asp-for="Product.IMEI1" class="form-control" />
        <span asp-validation-for="Product.IMEI1" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Product.IMEI2" class="form-label">IMEI 2</label>
        <input asp-for="Product.IMEI2" class="form-control" />
        <span asp-validation-for="Product.IMEI2" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Product.IsSecondHand" class="form-label">Second-hand</label>
        <select asp-for="Product.IsSecondHand" class="form-select">
            <option value="false">No</option>
            <option value="true">Yes</option>
        </select>
    </div>

    <div class="col-md-3" data-guarantee-block style="display:none">
        <label asp-for="Product.GuaranteeCorporation" class="form-label">Guarantee corporation</label>
        <select asp-for="Product.GuaranteeCorporation" asp-items="@(new SelectList(Model.Corporations))" class="form-select">
            <option value="">-- Select corporation --</option>
        </select>
        <label asp-for="Product.GuaranteeExpiry" class="form-label mt-2">Guarantee expiry</label>
        <input asp-for="Product.GuaranteeExpiry" class="form-control" type="text" data-jalali-date placeholder="1405/12/29" value="@(Model.Product.GuaranteeExpiry.HasValue ? Model.Product.GuaranteeExpiry.Value.ToJalaliDateString() : string.Empty)" />
        <label asp-for="Product.GuaranteeNotes" class="form-label mt-2">Guarantee notes</label>
        <input asp-for="Product.GuaranteeNotes" class="form-control" />
    </div>

    <div class="col-md-3">
        <label asp-for="Product.Notes" class="form-label">Notes</label>
        <textarea asp-for="Product.Notes" class="form-control" rows="3"></textarea>
    </div>
}

