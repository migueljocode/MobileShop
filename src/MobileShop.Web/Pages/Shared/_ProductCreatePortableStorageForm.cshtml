@model MobileShop.Models.ViewModels.Web.BindModels.CreatePortableStorageInputModel
@{
    var manufacturers = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Manufacturers"]!;
    var models = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Models"]!;
}
<div class="row g-3" data-create-product-type="portablestorage">
    <div class="col-md-6"><label class="form-label">Manufacturer</label><select name="input.ManufacturerId" class="form-select" data-accessory-manufacturer><option value="">-- Select manufacturer --</option>@foreach (var option in manufacturers) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-6"><label class="form-label">Model</label><select name="input.ModelId" class="form-select" data-accessory-model><option value="">-- Select model --</option>@foreach (var option in models) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-4"><label class="form-label">Storage kind</label><select name="input.StorageKind" class="form-select">@foreach (var option in Html.GetEnumSelectList<MobileShop.Models.Enums.StorageKind>()) { <option value="@option.Value">@option.Text</option> }</select></div>
    <div class="col-md-4"><label class="form-label">Storage capacity ID</label><input name="input.StorageCapacityId" class="form-control" type="number" min="1" value="@Model.StorageCapacityId" /></div>
    <div class="col-md-4"><label class="form-label">Speed (MB/s)</label><input name="input.Speed" class="form-control" type="number" min="0" value="@Model.Speed" /></div>
    <div class="col-md-4"><label class="form-label">Paid price (IRR)</label><input name="input.Price" class="form-control" inputmode="numeric" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" value="@Model.Price" /></div>
    <div class="col-md-4"><label class="form-label">Profit %</label><input name="input.ProfitPercent" class="form-control" type="number" step="0.01" min="0" value="@Model.ProfitPercent" /></div>
    <div class="col-md-4"><label class="form-label">Profit amount (IRR)</label><input name="input.ProfitAmount" class="form-control" inputmode="numeric" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" value="@Model.ProfitAmount" /></div>
    <div class="col-12"><label class="form-label">Count</label><input name="input.Count" class="form-control" type="number" min="1" value="@Model.Count" /></div>
</div>