@using System.Globalization
@model MobileShop.Models.ViewModels.Web.ProductPickerViewModel
@{
    var productIdName = $"{Model.FieldPrefix}.ProductId";
    var productIdId = $"{Model.FieldPrefix}_ProductId";
    var priceName = $"{Model.FieldPrefix}.Price";
    var priceId = $"{Model.FieldPrefix}_Price";
}
<label class="form-label" for="@productIdId">Product</label>
<select class="form-select" id="@productIdId" name="@productIdName" data-product-picker>
    <option value="0">Select product</option>
    @foreach (var product in Model.Products)
    {
        var label = $"{product.Type}: {product.Name} — {product.Identifier}" +
            (string.IsNullOrWhiteSpace(product.Color) ? string.Empty : $" — {product.Color}") +
            (product.PartNumberLabel == "N/A" ? string.Empty : $" — {product.PartNumberLabel}");
        <option value="@product.ProductId" data-suggested-price="@(product.SuggestedPrice?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)">@label</option>
    }
</select>
<span class="text-danger" data-valmsg-for="@productIdName" data-valmsg-replace="true"></span>
<div class="form-text mt-1">Suggested price: <span data-suggested-price-display>—</span></div>
<label class="form-label mt-2" for="@priceId">Finished price</label>
<input class="form-control" id="@priceId" name="@priceName" data-finished-price-input />
<span class="text-danger" data-valmsg-for="@priceName" data-valmsg-replace="true"></span>
<script>
(function () {
    var picker = document.querySelector('[data-product-picker]');
    var priceInput = document.querySelector('[data-finished-price-input]');
    var suggestedDisplay = document.querySelector('[data-suggested-price-display]');
    if (!picker || !priceInput) return;
    picker.addEventListener('change', function () {
        var option = picker.options[picker.selectedIndex];
        var suggested = option ? option.getAttribute('data-suggested-price') : '';
        if (suggestedDisplay) suggestedDisplay.textContent = suggested ? suggested : '—';
        // Always set finished = suggested on product change (documented UX rule).
        if (suggested) priceInput.value = suggested;
    });
})();
</script>
