@model MobileShop.Models.ViewModels.Web.BindModels.CreatePowerBankInputModel
@{
    var manufacturers = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Manufacturers"]!;
    var models = (IReadOnlyList<MobileShop.Models.ViewModels.Web.DropdownOptionViewModel>)ViewData["Models"]!;
}
<div class="row g-3" data-create-product-type="powerbank">
    <div class="col-md-6"><label class="form-label">Manufacturer</label><select name="input.ManufacturerId" class="form-select" data-accessory-manufacturer><option value="">-- Select manufacturer --</option>@foreach (var option in manufacturers) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-6"><label class="form-label">Model</label><select name="input.ModelId" class="form-select" data-accessory-model><option value="">-- Select model --</option>@foreach (var option in models) { <option value="@option.Id">@option.Name</option> }</select></div>
    <div class="col-md-4"><label class="form-label">Capacity (mAh)</label><input name="input.CapacityMah" class="form-control" type="number" min="0" value="@Model.CapacityMah" /></div>
    <div class="col-md-4"><label class="form-label">Max wattage</label><input name="input.MaxWattage" class="form-control" type="number" min="0" value="@Model.MaxWattage" /></div>
    <div class="col-md-4"><label class="form-label">Port count</label><input name="input.PortCount" class="form-control" type="number" min="1" value="@Model.PortCount" /></div>
    <div class="col-12"><div class="form-check"><input name="input.Pd" value="true" type="checkbox" class="form-check-input" /><label class="form-check-label">USB Power Delivery</label></div></div>
    <div class="col-md-4"><label class="form-label">Paid price (Toman)</label><input name="input.Price" class="form-control" inputmode="numeric" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" value="@Model.Price" /></div>
    <div class="col-md-4"><label class="form-label">Profit %</label><input name="input.ProfitPercent" class="form-control" type="number" step="0.01" min="0" value="@Model.ProfitPercent" /></div>
    <div class="col-md-4"><label class="form-label">Profit amount (Toman)</label><input name="input.ProfitAmount" class="form-control" inputmode="numeric" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" value="@Model.ProfitAmount" /></div>
    <div class="col-12"><label class="form-label">Count</label><input name="input.Count" class="form-control" type="number" min="1" value="@Model.Count" /></div>
</div>