@page
@model MobileShop.Web.Pages.Transactions.DetailsModel
@{
    ViewData["Title"] = "Transaction details";
}
<h1>Transaction details</h1>
@if (Model.Transaction is not null)
{
    <dl class="row">
        <dt class="col-sm-3">Direction</dt><dd class="col-sm-9">@Model.Transaction.Direction</dd>
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.Transaction.Date.ToString("yyyy-MM-dd HH:mm")</dd>
        <dt class="col-sm-3">Product</dt><dd class="col-sm-9">@Model.Transaction.ProductLabel</dd>
        <dt class="col-sm-3">Finished price</dt><dd class="col-sm-9">@Model.Transaction.FinishedPrice.ToString("N0")</dd>
        <dt class="col-sm-3">Seller</dt><dd class="col-sm-9">@Model.Transaction.SellerLabel</dd>
        <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Transaction.CustomerLabel</dd>
    </dl>
    <a asp-page="/Transactions/Details" asp-page-handler="Factor" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Factor</a>
    <a asp-page="/Transactions" class="btn btn-outline-primary ms-2">Back to transactions</a>
}
