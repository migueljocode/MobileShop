@page
@model MobileShop.Web.Pages.Transactions.SellModel
@{
    ViewData["Title"] = "Record sell";
}
<h1>Record sell</h1>
<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="Input.ProductId" class="form-label"></label><input asp-for="Input.ProductId" class="form-control" /><span asp-validation-for="Input.ProductId" class="text-danger"></span>
    <label asp-for="Input.CustomerId" class="form-label mt-2">Customer</label><select asp-for="Input.CustomerId" class="form-select"><option value="0">Select customer</option>@foreach (var customer in Model.Customers) { <option value="@customer.Id">@customer.Id - @customer.PersonNavigation.FirstName @customer.PersonNavigation.LastName</option> }</select>
    <label asp-for="Input.Price" class="form-label mt-2"></label><input asp-for="Input.Price" class="form-control" /><span asp-validation-for="Input.Price" class="text-danger"></span>
    <label asp-for="Input.Date" class="form-label mt-2"></label><input asp-for="Input.Date" class="form-control" /><button class="btn btn-primary mt-3">Record sell</button>
</form>
@if (Model.Message is not null) { <div class="alert alert-success mt-3">@Model.Message</div> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
