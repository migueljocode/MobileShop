@page
@model MobileShop.Web.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Transactions";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Transactions</h1>
        <p class="page-head__sub">Buys and sells</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-dark" asp-page="/Transactions/Sell">Record Sell</a>
    </div>
</div>

<div>
    <form method="get">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="order" value="@Model.Order" />

        <div class="row g-2 mb-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="direction">Direction</label>
                <select id="direction" name="direction" class="form-select">
                    <option value="all">All</option>
                    <option value="buy" selected="@(Model.Direction == "buy")">Buy</option>
                    <option value="sell" selected="@(Model.Direction == "sell")">Sell</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="customerId">Customer</label>
                <select id="customerId" name="customerId" class="form-select">
                    <option value="">All customers</option>
                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id" selected="@(Model.CustomerId == customer.Id)">@customer.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="dateRange">Date</label>
                <select id="dateRange" name="dateRange" class="form-select">
                    <option value="today" selected="@(Model.DateRange == "today")">Today</option>
                    <option value="week" selected="@(Model.DateRange == "week")">This week</option>
                    <option value="month" selected="@(Model.DateRange == "month")">This month</option>
                    <option value="year" selected="@(Model.DateRange == "year")">This year</option>
                    <option value="all" selected="@(Model.DateRange == "all")">All time</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="take">Count</label>
                <input id="take" class="form-control" type="number" name="take" min="1" max="500" value="@Model.Take" />
            </div>
        </div>

        <p class="d-flex flex-wrap gap-2">
            <button type="submit" name="handler" value="DownloadFactor" class="btn btn-primary">Download Factor (PDF)</button>
        </p>

        @if (Model.Transactions.Count == 0)
        {
            <p class="text-muted">No transactions found.</p>
        }
        else
        {
            <p class="text-muted small">
                Tick one or more rows to download a factor for exactly those transactions, or leave every row
                unticked to use the direction/customer/date/count/sort filters above.
            </p>
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Select</span></th>
                        <th scope="col" aria-sort="@(Model.Sort == "date" ? (Model.Order == "asc" ? "ascending" : "descending") : "none")">
                            <a href="@Url.Page("/Transactions/Index", new { direction = Model.Direction, customerId = Model.CustomerId, dateRange = Model.DateRange, take = Model.Take, sort = "date", order = Model.Sort == "date" && Model.Order == "desc" ? "asc" : "desc" })">
                                Date
                                @if (Model.Sort == "date")
                                {
                                    <span aria-hidden="true">@(Model.Order == "asc" ? "↑" : "↓")</span>
                                }
                            </a>
                        </th>
                        <th scope="col">Direction</th>
                        <th scope="col" aria-sort="@(Model.Sort == "product" ? (Model.Order == "asc" ? "ascending" : "descending") : "none")">
                            <a href="@Url.Page("/Transactions/Index", new { direction = Model.Direction, customerId = Model.CustomerId, dateRange = Model.DateRange, take = Model.Take, sort = "product", order = Model.Sort == "product" && Model.Order == "desc" ? "asc" : "desc" })">
                                Product
                                @if (Model.Sort == "product")
                                {
                                    <span aria-hidden="true">@(Model.Order == "asc" ? "↑" : "↓")</span>
                                }
                            </a>
                        </th>
                        <th scope="col" class="num" aria-sort="@(Model.Sort == "price" ? (Model.Order == "asc" ? "ascending" : "descending") : "none")">
                            <a href="@Url.Page("/Transactions/Index", new { direction = Model.Direction, customerId = Model.CustomerId, dateRange = Model.DateRange, take = Model.Take, sort = "price", order = Model.Sort == "price" && Model.Order == "desc" ? "asc" : "desc" })">
                                Price (Toman)
                                @if (Model.Sort == "price")
                                {
                                    <span aria-hidden="true">@(Model.Order == "asc" ? "↑" : "↓")</span>
                                }
                            </a>
                        </th>
                        <th scope="col" aria-sort="@(Model.Sort == "seller" ? (Model.Order == "asc" ? "ascending" : "descending") : "none")">
                            <a href="@Url.Page("/Transactions/Index", new { direction = Model.Direction, customerId = Model.CustomerId, dateRange = Model.DateRange, take = Model.Take, sort = "seller", order = Model.Sort == "seller" && Model.Order == "desc" ? "asc" : "desc" })">
                                Seller
                                @if (Model.Sort == "seller")
                                {
                                    <span aria-hidden="true">@(Model.Order == "asc" ? "↑" : "↓")</span>
                                }
                            </a>
                        </th>
                        <th scope="col" aria-sort="@(Model.Sort == "customer" ? (Model.Order == "asc" ? "ascending" : "descending") : "none")">
                            <a href="@Url.Page("/Transactions/Index", new { direction = Model.Direction, customerId = Model.CustomerId, dateRange = Model.DateRange, take = Model.Take, sort = "customer", order = Model.Sort == "customer" && Model.Order == "desc" ? "asc" : "desc" })">
                                Customer
                                @if (Model.Sort == "customer")
                                {
                                    <span aria-hidden="true">@(Model.Order == "asc" ? "↑" : "↓")</span>
                                }
                            </a>
                        </th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model.Transactions)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input" type="checkbox" name="selectedIds" value="@transaction.Id"
                                       checked="@Model.SelectedIds.Contains(transaction.Id)" />
                            </td>
                            <td>@transaction.Date.ToJalaliDateTimeString()</td>
                            <td>@transaction.Direction</td>
                            <td>@transaction.ProductLabel</td>
                            <td class="num">@transaction.FinishedPrice.ToIrr()</td>
                            <td>@transaction.SellerLabel</td>
                            <td>@transaction.CustomerLabel</td>
                            <td>
                                <a asp-page="/Transactions/Details" asp-route-id="@transaction.Id">Details</a>
                                |
                                <a href="@Url.Page("/Transactions/Index", "DownloadFactor", new { direction = Model.Direction, customerId = Model.CustomerId, dateRange = Model.DateRange, take = Model.Take, sort = Model.Sort, order = Model.Order, selectedIds = transaction.Id })">Download Factor</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </form>
</div>

@section Scripts {
    <script>
        // Auto-submit the filter form when direction changes.
        document.getElementById('direction').addEventListener('change', function () {
            this.form.requestSubmit();
        });
        document.getElementById('customerId').addEventListener('change', function () {
            this.form.requestSubmit();
        });
        document.getElementById('dateRange').addEventListener('change', function () {
            this.form.requestSubmit();
        });

        // Debounced auto-submit when the Count (take) field changes.
        let countDebounceTimer = null;
        const COUNT_DEBOUNCE_MS = 300;

        document.getElementById('take').addEventListener('input', function () {
            clearTimeout(countDebounceTimer);
            countDebounceTimer = setTimeout(function () {
                document.getElementById('take').form.requestSubmit();
            }, COUNT_DEBOUNCE_MS);
        });
    </script>
}
