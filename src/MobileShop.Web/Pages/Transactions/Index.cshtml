@page
@model MobileShop.Web.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Transactions";
}

<!-- Shared print CSS: hide layout chrome (header/nav/footer) and screen-only content when printing. -->
<style>
    @@media print {
        header, footer, nav, .screen-only, h1 { display: none !important; }
    }
</style>

@if (Model.IsPrintMode)
{
    <!-- Auto-trigger the browser print dialog after the factor renders. -->
    <script>window.onload = () => window.print();</script>

                <!-- The print-only factor layout: visible on screen while rendering, hidden on screen via CSS. -->
    <div class="factor-print">
        <style>
            @@media print {
                body { margin: 0; padding: 10mm; }
                .factor-table th, .factor-table td { border: 1px solid #000 !important; padding: 4px 8px; }
                .factor-table th { background: #f5f5f5 !important; }
                .text-end { text-align: right !important; }
                h2 { font-size: 18pt; margin-bottom: 4pt; }
                .text-muted { font-size: 9pt; color: #666 !important; }
            }

            @@media screen {
                .factor-print { display: none !important; }
            }
        </style>

        <div class="text-center mb-4">
            <h2>Transaction Factor</h2>
            <p class="text-muted">Generated on @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>
        </div>

        <table class="table table-bordered factor-table">
            <thead>
                <tr>
                    <th>Tx#</th>
                    <th>Date</th>
                    <th>Direction</th>
                    <th>Product</th>
                    <th class="text-end">Price</th>
                    <th>Party</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.PrintFactorRows)
                {
                    <tr>
                        <td>@row.TransactionId</td>
                        <td>@row.Date.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@row.Direction</td>
                        <td>@row.ProductLabel</td>
                        <td class="text-end">@row.FinishedPrice.ToString("N0")</td>
                        <td>@row.PersonRole: @row.PersonLabel</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="4" class="text-end">Total:</td>
                    <td class="text-end">@Model.PrintFactorRows.Sum(r => r.FinishedPrice).ToString("N0")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}
else
{
    <!-- Normal transaction list screen view. Hidden in print via CSS. -->
    <div class="screen-only">
        <h1>Transactions</h1>

        <form method="get">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-2 mb-3">
                <div class="col-md-3">
                    <label class="form-label" for="direction">Direction</label>
                    <select id="direction" name="direction" class="form-select">
                        <option value="all">All</option>
                        <option value="buy" selected="@(Model.Direction == "buy")">Buy</option>
                        <option value="sell" selected="@(Model.Direction == "sell")">Sell</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="take">Count</label>
                    <input id="take" class="form-control" type="number" name="take" min="1" max="500" value="@Model.Take" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="order">Order</label>
                    <select id="order" name="order" class="form-select">
                        <option value="desc" selected="@(Model.Order == "desc")">Newest first</option>
                        <option value="asc" selected="@(Model.Order == "asc")">Oldest first</option>
                    </select>
                </div>
            </div>

            <p class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-page="/Transactions/Buy">Record Buy</a>
                <a class="btn btn-dark" asp-page="/Transactions/Sell">Record Sell</a>
                <button type="submit" class="btn btn-outline-primary">Apply filters</button>
                <button type="submit" asp-page-handler="PrintFactor" class="btn btn-primary">Print Factor</button>
            </p>

            @if (Model.Transactions.Count == 0)
            {
                <p class="text-muted">No transactions found.</p>
            }
            else
            {
                <p class="text-muted small">
                    Tick one or more rows to build a factor for exactly those transactions, or leave every row
                    unticked to use the direction/count/order filters above.
                </p>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col"><span class="visually-hidden">Select</span></th>
                            <th scope="col">Date</th>
                            <th scope="col">Direction</th>
                            <th scope="col">Product</th>
                            <th scope="col">Price</th>
                            <th scope="col">Seller</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model.Transactions)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input" type="checkbox" name="selectedIds" value="@transaction.Id"
                                           checked="@Model.SelectedIds.Contains(transaction.Id)" />
                                </td>
                                <td>@transaction.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@transaction.Direction</td>
                                <td>@transaction.ProductLabel</td>
                                <td>@transaction.FinishedPrice.ToString("N0")</td>
                                <td>@transaction.SellerLabel</td>
                                <td>@transaction.CustomerLabel</td>
                                <td>
                                                                        <a asp-page="/Transactions/Details" asp-route-id="@transaction.Id">Details</a>
                                    |
                                    <a asp-page="/Transactions" asp-page-handler="PrintFactor" asp-route-direction="@Model.Direction" asp-route-take="@Model.Take" asp-route-order="@Model.Order" asp-route-selectedIds="@transaction.Id">Factor</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </form>
    </div>
}
