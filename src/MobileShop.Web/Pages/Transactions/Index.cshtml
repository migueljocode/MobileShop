@page
@model MobileShop.Web.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Transactions";
}
<h1>Transactions</h1>
<p><a class="btn btn-primary" asp-page="/Transactions/Buy">Record Buy</a> <a class="btn btn-dark" asp-page="/Transactions/Sell">Record Sell</a> <a class="btn btn-outline-secondary" asp-page="/Transactions" asp-page-handler="Print">Print</a> <a class="btn btn-outline-secondary" asp-page="/Transactions" asp-page-handler="DownloadPdf">Download PDF</a></p>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><label class="form-label">Direction</label><select name="direction" class="form-select"><option value="all">All</option><option value="buy" selected="@(Model.Direction == "buy")">Buy</option><option value="sell" selected="@(Model.Direction == "sell")">Sell</option></select></div>
    <div class="col-md-2"><label class="form-label">Count</label><input class="form-control" type="number" name="take" min="1" max="500" value="@Model.Take" /></div>
    <div class="col-md-3"><label class="form-label">Order</label><select name="order" class="form-select"><option value="desc" selected="@(Model.Order == "desc")">Newest first</option><option value="asc" selected="@(Model.Order == "asc")">Oldest first</option></select></div>
    <div class="col-md-2 align-self-end"><button class="btn btn-outline-primary">Apply</button></div>
</form>
@if (Model.Transactions.Count == 0) { <p class="text-muted">No transactions found.</p> }
else
{
    <table class="table table-striped"><thead><tr><th>Date</th><th>Direction</th><th>Product</th><th>Price</th><th>Seller</th><th>Customer</th></tr></thead>
    <tbody>@foreach (var transaction in Model.Transactions)
    { <tr><td>@transaction.Date.ToString("yyyy-MM-dd HH:mm")</td><td>@transaction.Direction</td><td>@transaction.ProductLabel</td><td>@transaction.FinishedPrice.ToString("N0")</td><td>@transaction.SellerLabel</td><td>@transaction.CustomerLabel</td><td><a asp-page="/Transactions/Details" asp-route-id="@transaction.Id">Details</a></td></tr> }</tbody></table>
}
