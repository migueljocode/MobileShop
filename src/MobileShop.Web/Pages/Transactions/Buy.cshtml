@page
@model MobileShop.Web.Pages.Transactions.BuyModel
@{
    ViewData["Title"] = "Record buy";
}
<h1>Record buy</h1>
<a asp-page="/Transactions/Index" class="btn btn-secondary mb-3">Back</a>
<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div data-product-picker data-search-handler="SearchProducts">
        <label for="buy-product-search" class="form-label">Product</label>
        <div class="row g-2 mb-2">
            <div class="col-md-4"><label for="buy-product-type" class="form-label">Type</label><select id="buy-product-type" class="form-select" data-product-type-filter><option value="">All types</option></select></div>
            <div class="col-md-4"><label for="buy-product-manufacturer" class="form-label">Manufacturer</label><select id="buy-product-manufacturer" class="form-select" data-product-manufacturer-filter><option value="">All manufacturers</option></select></div>
            <div class="col-md-4"><label for="buy-product-model" class="form-label">Model</label><select id="buy-product-model" class="form-select" data-product-model-filter disabled><option value="">All models</option></select></div>
        </div>
        <input type="hidden" name="Input.ProductId" id="Input_ProductId" value="@Model.Input.ProductId" data-product-value />
        <input id="buy-product-search" type="text" class="form-control" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="product-results" aria-expanded="false" placeholder="Search by name, identifier, color or part number" data-product-search />
        <partial name="/Pages/Shared/_ProductPickerOptions.cshtml" model="new ProductPickerViewModel(Model.Products, Model.Input.ProductId)" />
    </div>
    <span asp-validation-for="Input.ProductId" class="text-danger"></span>
    <div class="mt-2 d-flex gap-2 align-items-center">
        <label asp-for="Input.Price" class="form-label mb-0"></label>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#create-product-modal">Create product</button>
    </div>
    <input asp-for="Input.Price" class="form-control" data-finished-price-input inputmode="numeric" step="1" min="0" max="@MobileShop.Models.MoneyLimits.MaxRials" />
    <span asp-validation-for="Input.Price" class="text-danger"></span>
    @{
        ViewData["PersonPickerRole"] = "seller";
    }
    <partial name="/Pages/Shared/_PersonPicker.cshtml" model="Model.Sellers" view-data="ViewData" />
    <label asp-for="Input.Date" class="form-label mt-2"></label><input asp-for="Input.Date" type="date" class="form-control" /><button class="btn btn-primary mt-3">Record buy</button>
</form>
@if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> }

<div class="modal fade" id="create-product-modal" tabindex="-1" aria-labelledby="create-product-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="create-product-modal-title">Create product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="create-product-form" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <label for="create-product-type" class="form-label">Product type</label>
                    <select id="create-product-type" class="form-select">
                        <option value="">-- Select type --</option>
                        <option value="phone">Phone</option>
                        <option value="appleid">Apple ID</option>
                        <option value="glass">Glass</option>
                    </select>
                    <div id="create-product-form-host" class="mt-3"></div>
                    <div id="create-product-status" class="small mt-2 text-muted" role="alert"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create product</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/product-picker.js"></script><script src="~/js/person-picker.js"></script><script src="~/js/product-create-modal.js"></script> }