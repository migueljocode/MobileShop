@page
@model MobileShop.Web.Pages.Transactions.BuyModel
@{
    ViewData["Title"] = "Record buy";
}
<h1>Record buy</h1>
<a asp-page="/Transactions/Index" class="btn btn-secondary mb-3">Back</a>
<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="Input.ProductId" class="form-label">Product</label><select asp-for="Input.ProductId" class="form-select" data-product-picker><option value="0">Select product</option><partial name="/Pages/Shared/_ProductPickerOptions.cshtml" model="new ProductPickerViewModel(Model.Products)" /></select><span asp-validation-for="Input.ProductId" class="text-danger"></span>
    <label asp-for="Input.Price" class="form-label mt-2"></label><input asp-for="Input.Price" class="form-control" data-finished-price-input /><span asp-validation-for="Input.Price" class="text-danger"></span>
    <label asp-for="Input.SellerId" class="form-label mt-2">Seller</label><select asp-for="Input.SellerId" class="form-select"><option value="0">Select seller</option>@foreach (var seller in Model.Sellers) { <option value="@seller.Id">@seller.Label@(string.IsNullOrWhiteSpace(seller.TypeLabel) ? string.Empty : $" ({seller.TypeLabel})")</option> }</select><span asp-validation-for="Input.SellerId" class="text-danger"></span>
    <label asp-for="Input.Date" class="form-label mt-2"></label><input asp-for="Input.Date" type="date" class="form-control" /><button class="btn btn-primary mt-3">Record buy</button>
</form>
@if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/product-picker.js"></script> }
