@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-head"><div><h1 class="page-head__title">Error</h1><p class="page-head__sub">An error occurred while processing your request.</p></div></div>

<div class="measure">
<p>Something went wrong. Try again, and if the problem continues contact support.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
</div>
