@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center">
    <h1 class="display-4">MobileShop</h1>
    <p class="lead">Inventory &amp; sales dashboard</p>
</div>

<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="card text-bg-success h-100">
            <div class="card-body text-center">
                <h2 class="card-title">@Model.PhonesInStock</h2>
                <p class="card-text">Phones in stock</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning h-100">
            <div class="card-body text-center">
                <h2 class="card-title">@Model.PhonesSecondHand</h2>
                <p class="card-text">Second-hand phones</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-info h-100">
            <div class="card-body text-center">
                <h2 class="card-title">@Model.PhonesSecondHandAvailable</h2>
                <p class="card-text">Second-hand available</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body text-center">
                <h2 class="card-title">@Model.AppleIdsInStock</h2>
                <p class="card-text">Apple IDs in stock</p>
            </div>
        </div>
    </div>
</div>

<h2>Phones</h2>
@if (Model.Phones.Count == 0)
{
    <p class="text-muted">No phones on record.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>IMEI 1</th>
                <th>IMEI 2</th>
                <th>Ownership transferred</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var phone in Model.Phones)
            {
                <tr>
                    <td>@phone.Id</td>
                    <td>@phone.Imei1</td>
                    <td>@(phone.Imei2 ?? "—")</td>
                    <td>@(phone.OwnershipTransferred ? "Yes" : "No")</td>
                    <td>
                        <span class="badge @(phone.IsSold ? "text-bg-secondary" : "text-bg-success")">
                            @(phone.IsSold ? "Sold" : "In stock")
                        </span>
                        @if (phone.IsSecondHand)
                        {
                            <span class="badge text-bg-warning">Second-hand</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recent transactions</h2>
@if (Model.RecentTransactions.Count == 0)
{
    <p class="text-muted">No transactions yet.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Direction</th>
                <th>Price</th>
                <th>Product</th>
                <th>Seller</th>
                <th>Customer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in Model.RecentTransactions)
            {
                <tr>
                    <td>@transaction.Id</td>
                    <td>@transaction.Date.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <span class="badge @(transaction.Direction == TransactionDirection.Buy ? "text-bg-primary" : "text-bg-dark")">
                            @transaction.Direction
                        </span>
                    </td>
                    <td>@transaction.FinishedPrice.ToString("N0")</td>
                    <td>@transaction.ProductId</td>
                    <td>@transaction.SellerId</td>
                    <td>@transaction.CustomerId</td>
                </tr>
            }
        </tbody>
    </table>
}
