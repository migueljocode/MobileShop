@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-head"><div><h1 class="page-head__title">Dashboard</h1><p class="page-head__sub">Inventory and sales</p></div></div>

<div class="stat-grid">
    <div class="stat">
        <div class="stat__value num">@Model.Stock.PhonesInStock</div>
        <div class="stat__label">Phones in stock</div>
    </div>
    <div class="stat">
        <div class="stat__value num">@Model.Stock.PhonesSecondHand</div>
        <div class="stat__label">Second-hand phones</div>
    </div>
    <div class="stat">
        <div class="stat__value num">@Model.Stock.PhonesSecondHandAvailable</div>
        <div class="stat__label">Second-hand available</div>
    </div>
    <div class="stat">
        <div class="stat__value num">@Model.Stock.AppleIdsInStock</div>
        <div class="stat__label">Apple IDs in stock</div>
    </div>
</div>

<h2>Recent transactions</h2>
@if (Model.RecentTransactions.Count == 0)
{
    <p class="text-muted">No transactions yet.</p>
}
else
{
    <div class="row g-3">
        @foreach (var transaction in Model.RecentTransactions)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@transaction.ProductLabel</h5>
                        <p class="card-text mb-1">@transaction.Date.ToJalaliDateTimeString()</p>
                    <span class="badge @(transaction.Direction == TransactionDirection.Buy ? "text-bg-primary" : "text-bg-dark")">
                        @transaction.Direction
                    </span>
                        <p class="card-text mt-2 mb-0">Finished price (Toman): @transaction.FinishedPrice.ToIrr()</p>
                        <p class="card-text mb-0">@transaction.PartyLabel</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
