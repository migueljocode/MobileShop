@page
@model ShopProfileModel
@{
    ViewData["Title"] = "Shop profile";
}

<div class="page-head">
<div>
<h1 class="page-head__title">Shop profile</h1>
<p class="page-head__sub">Shop details printed on generated invoices</p>
</div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <section class="form-section" aria-label="Shop details">
            <h2 class="form-section__title">Shop details</h2>
            <form method="post" asp-antiforgery="true">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Phone" class="form-label"></label>
                    <input asp-for="Input.Phone" class="form-control" dir="ltr" />
                    <span asp-validation-for="Input.Phone" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Address" class="form-label"></label>
                    <textarea asp-for="Input.Address" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Instagram" class="form-label"></label>
                    <input asp-for="Input.Instagram" class="form-control" dir="ltr" />
                    <span asp-validation-for="Input.Instagram" class="text-danger"></span>
                </div>
                <div class="action-bar">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="alert alert-info mt-3" role="status">@Model.Message</div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
