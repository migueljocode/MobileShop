@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="account-login-page">
    <section class="account-login-card" aria-labelledby="login-heading">
        <div class="account-login-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 10.2 12 4l8 6.2v8.3a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5z" />
                <path d="M9 20v-6h6v6M8 10h.01M16 10h.01" />
            </svg>
        </div>
        <p class="account-login-eyebrow">MobileShop workspace</p>
        <h1 class="account-login-title" id="login-heading">Welcome back</h1>
        <p class="account-login-description">Sign in to manage your inventory and sales.</p>

        <form method="post" asp-antiforgery="true" class="account-login-form">
            <div asp-validation-summary="ModelOnly" class="account-login-validation" role="alert"></div>

            <div class="account-login-field">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus placeholder="Enter your username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="account-login-field">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="btn btn-primary account-login-submit">
                <span>Sign in</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
            </button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-success account-login-message" role="status">@Model.Message</div>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
