@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="account-login-page">
    <section class="account-login-card" aria-labelledby="login-heading">
        <div class="account-login-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 10.2 12 4l8 6.2v8.3a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5z" />
                <path d="M9 20v-6h6v6M8 10h.01M16 10h.01" />
            </svg>
        </div>
        <p class="account-login-eyebrow">MobileShop workspace</p>
        <h1 class="account-login-title" id="login-heading">Welcome back</h1>
        <p class="account-login-description">Sign in to manage your inventory and sales.</p>

        <form method="post" asp-antiforgery="true" class="account-login-form">
            <div asp-validation-summary="ModelOnly" class="account-login-validation" role="alert"></div>

            <div class="account-login-field">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus placeholder="Enter your username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="account-login-field">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="Enter your password" />
                    <button class="btn btn-outline-secondary password-visibility-toggle" type="button"
                            data-password-toggle="Password" aria-label="Show password" title="Show password" aria-pressed="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <g class="password-eye-closed">
                            <path d="M3 3 21 21" />
                            <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                            <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.7 15.7 0 0 1-3.2 4.1M6.2 6.2C3.5 8.1 2 12 2 12s3.6 7 10 7c1.1 0 2.1-.2 3-.6" />
                        </g>
                        <g class="password-eye-open">
                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="3" />
                        </g>
                    </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="btn btn-primary account-login-submit">
                <span>Sign in</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
            </button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-success account-login-message" role="status">@Model.Message</div>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
