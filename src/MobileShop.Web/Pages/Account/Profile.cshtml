@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="card-title h4 mb-3">Profile</h1>
                <hr class="mb-4">
                <dl class="row">
                    <dt class="col-sm-2">Username</dt>
                    <dd class="col-sm-10">@Model.Username</dd>
                    <dt class="col-sm-2">Email</dt>
                    <dd class="col-sm-10">(Not displayed for security)</dt>
                </dl>
                <hr class="my-4">
                <form method="post" asp-antiforgery="true">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save changes</button>
                </form>
                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="alert alert-info mt-3">@Model.Message</div>
                }
                <hr class="my-3">
                <p class="text-muted small">
                    Authentication is not enabled in this stage. This profile page is for testing purposes only.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_validationScriptsPartial" />
}
