@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="page-head"><div><h1 class="page-head__title">Profile</h1><p class="page-head__sub" dir="auto">@Model.Username</p></div></div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <section class="form-section" aria-label="Account details">
            <h2 class="form-section__title">Account details</h2>
            <dl class="row">
                <dt class="col-sm-3 text-nowrap">Username</dt>
                <dd class="col-sm-9 text-break" dir="auto">@Model.Username</dd>
            </dl>
        </section>
        <section class="form-section" aria-label="Change username or password">
            <h2 class="form-section__title">Change username or password</h2>
            <form method="post" asp-antiforgery="true">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="NewUsername" class="form-label"></label>
                    <input asp-for="NewUsername" class="form-control" autocomplete="username" />
                    <span asp-validation-for="NewUsername" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                        <partial name="_PasswordToggle" model='"CurrentPassword"' />
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <partial name="_PasswordToggle" model='"NewPassword"' />
                    </div>
                    <span class="form-text">Leave blank to keep the current password.</span>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <partial name="_PasswordToggle" model='"ConfirmPassword"' />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="action-bar">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="alert alert-info mt-3" role="status">@Model.Message</div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_validationScriptsPartial" />
}
