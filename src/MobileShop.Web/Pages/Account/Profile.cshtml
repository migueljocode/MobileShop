@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="card-title h4 mb-3">Profile</h1>
                <hr class="mb-4">
                <dl class="row">
                    <dt class="col-sm-3 text-nowrap">Username</dt>
                    <dd class="col-sm-9 text-break">@Model.Username</dd>
                </dl>
                <hr class="my-4">
                <form method="post" asp-antiforgery="true">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewUsername" class="form-label"></label>
                        <input asp-for="NewUsername" class="form-control" autocomplete="username" />
                        <span asp-validation-for="NewUsername" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                            <button class="btn btn-outline-secondary password-visibility-toggle" type="button"
                                    data-password-toggle="CurrentPassword" aria-label="Show password" title="Show password" aria-pressed="false">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <g class="password-eye-closed">
                                    <path d="M3 3 21 21" />
                                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                                    <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.7 15.7 0 0 1-3.2 4.1M6.2 6.2C3.5 8.1 2 12 2 12s3.6 7 10 7c1.1 0 2.1-.2 3-.6" />
                                </g>
                                <g class="password-eye-open">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </g>
                            </svg>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button class="btn btn-outline-secondary password-visibility-toggle" type="button"
                                    data-password-toggle="NewPassword" aria-label="Show password" title="Show password" aria-pressed="false">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <g class="password-eye-closed">
                                    <path d="M3 3 21 21" />
                                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                                    <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.7 15.7 0 0 1-3.2 4.1M6.2 6.2C3.5 8.1 2 12 2 12s3.6 7 10 7c1.1 0 2.1-.2 3-.6" />
                                </g>
                                <g class="password-eye-open">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </g>
                            </svg>
                            </button>
                        </div>
                        <span class="form-text">Leave blank to keep the current password.</span>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button class="btn btn-outline-secondary password-visibility-toggle" type="button"
                                    data-password-toggle="ConfirmPassword" aria-label="Show password" title="Show password" aria-pressed="false">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <g class="password-eye-closed">
                                    <path d="M3 3 21 21" />
                                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                                    <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.7 15.7 0 0 1-3.2 4.1M6.2 6.2C3.5 8.1 2 12 2 12s3.6 7 10 7c1.1 0 2.1-.2 3-.6" />
                                </g>
                                <g class="password-eye-open">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </g>
                            </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save changes</button>
                </form>
                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="alert alert-info mt-3">@Model.Message</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_validationScriptsPartial" />
}
