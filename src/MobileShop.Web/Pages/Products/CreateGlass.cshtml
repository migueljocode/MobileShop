@page
@model MobileShop.Web.Pages.Products.CreateGlassModel
@{
    ViewData["Title"] = "Create glass";
}

<h1>Create glass</h1>

<form id="productCreateForm" method="post" class="row g-3 col-lg-7 mx-auto">
    <partial name="/Pages/Shared/_ProductSellerPicker.cshtml" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Input.CompatibleManufacturerId" class="form-label">Compatible phone manufacturer</label>
        <div class="input-group">
            <select asp-for="Input.CompatibleManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, "Id", "Name"))" class="form-select" id="compatibleManufacturerSelect">
                <option value="">-- Select manufacturer --</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addCompatibleManufacturerModal">Add New</button>
        </div>
        <span asp-validation-for="Input.CompatibleManufacturerId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.CompatibleModelId" class="form-label">Compatible model</label>
        <div class="input-group">
            <select asp-for="Input.CompatibleModelId" asp-items="@(new SelectList(Model.CompatibleModels, "Id", "Name"))" class="form-select" id="compatibleModelSelect">
                <option value="">-- Select model --</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addCompatibleModelModal">Add New</button>
        </div>
        <span asp-validation-for="Input.CompatibleModelId" class="text-danger"></span>
    </div>


    <div class="col-md-6">
        <label asp-for="Input.GlassManufacturerId" class="form-label">Glass manufacturer</label>
        <div class="input-group">
            <select asp-for="Input.GlassManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, "Id", "Name"))" class="form-select" id="glassManufacturerSelect">
                <option value="">-- Select glass manufacturer --</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addGlassManufacturerModal">Add New</button>
        </div>
        <span asp-validation-for="Input.GlassManufacturerId" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.Price" class="form-label">Paid price (Toman)</label>
        <input asp-for="Input.Price" class="form-control" data-price inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" />
        <span asp-validation-for="Input.Price" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.ProfitPercent" class="form-label">Profit %</label>
        <div class="input-group">
            <input asp-for="Input.ProfitPercent" class="form-control" data-percent />
            <span class="input-group-text">%</span>
        </div>
        <span asp-validation-for="Input.ProfitPercent" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.ProfitAmount" class="form-label">Profit amount (Toman)</label>
        <input asp-for="Input.ProfitAmount" class="form-control" data-amount inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" />
        <span asp-validation-for="Input.ProfitAmount" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label class="form-label">Finished price (Toman)</label>
        <input type="text" class="form-control" data-finished-price readonly aria-readonly="true" tabindex="-1" />
        <span class="form-text text-muted">Server-stored price (paid + profit).</span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.Count" class="form-label">Count</label>
        <input asp-for="Input.Count" class="form-control" min="1" />
        <span asp-validation-for="Input.Count" class="text-danger"></span>
        <span class="form-text">Create one or more glass products in one save.</span>
    </div>

</form>
<div class="d-flex flex-wrap gap-2 mt-3">
    <button class="btn btn-primary" type="submit" form="productCreateForm">Save glass</button>
    <a asp-page="/Products/Index" class="btn btn-outline-secondary">Back to products</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success mt-3" role="status">@Model.Message</div>
}

<div class="modal fade" id="addGlassManufacturerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Add Glass Manufacturer</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body"><label for="newGlassManufacturerName" class="form-label">Name</label><input type="text" class="form-control" id="newGlassManufacturerName" required /></div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveGlassManufacturerBtn">Save</button></div>
    </div></div>
</div>

<div class="modal fade" id="addCompatibleManufacturerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Add Compatible Phone Manufacturer</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body"><label for="newCompatibleManufacturerName" class="form-label">Name</label><input type="text" class="form-control" id="newCompatibleManufacturerName" required /></div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveCompatibleManufacturerBtn">Save</button></div>
    </div></div>
</div>

<div class="modal fade" id="addCompatibleModelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Add Compatible Model</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div id="compatibleModelError" class="alert alert-danger d-none" role="alert"></div>
            <p class="form-text">This model will be added under the selected compatible phone manufacturer.</p>
            <label for="newCompatibleModelName" class="form-label">Model name</label>
            <input type="text" class="form-control" id="newCompatibleModelName" required />
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveCompatibleModelBtn">Save</button></div>
    </div></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-product-pricing.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const compatibleManufacturer = document.getElementById('compatibleManufacturerSelect');
            const compatibleModel = document.getElementById('compatibleModelSelect');
            const glassManufacturer = document.getElementById('glassManufacturerSelect');
            const modelName = document.getElementById('newCompatibleModelName');
            const modelError = document.getElementById('compatibleModelError');
            const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!compatibleManufacturer || !compatibleModel || !glassManufacturer) return;

            async function loadCompatibleModels() {
                compatibleModel.innerHTML = '<option value="">-- Select compatible model --</option>';
                if (!compatibleManufacturer.value) return;
                const response = await fetch('?handler=Models&manufacturerId=' + encodeURIComponent(compatibleManufacturer.value));
                if (!response.ok) throw new Error('Could not load compatible phone models.');
                const models = await response.json();
                for (const item of models) {
                    const option = document.createElement('option');
                    option.value = item.id;
                    option.textContent = item.name;
                    compatibleModel.appendChild(option);
                }
            }
            compatibleManufacturer.addEventListener('change', loadCompatibleModels);

            async function createManufacturer(name, select, modalId) {
                const response = await fetch('?handler=CreateManufacturer', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        ...(antiforgeryToken ? { RequestVerificationToken: antiforgeryToken } : {})
                    },
                    body: new URLSearchParams({ name })
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'Could not create the manufacturer.');
                const option = new Option(result.name, result.id, true, true);
                select.appendChild(option);
                if (select === compatibleManufacturer) await loadCompatibleModels();
                bootstrap.Modal.getOrCreateInstance(document.getElementById(modalId)).hide();
            }

            document.getElementById('saveCompatibleManufacturerBtn').addEventListener('click', async function () {
                const name = document.getElementById('newCompatibleManufacturerName').value.trim();
                if (!name) return;
                try {
                    await createManufacturer(name, compatibleManufacturer, 'addCompatibleManufacturerModal');
                    document.getElementById('newCompatibleManufacturerName').value = '';
                } catch (error) {
                    window.alert(error.message);
                }
            });

            document.getElementById('saveGlassManufacturerBtn').addEventListener('click', async function () {
                const name = document.getElementById('newGlassManufacturerName').value.trim();
                if (!name) return;
                try {
                    await createManufacturer(name, glassManufacturer, 'addGlassManufacturerModal');
                    document.getElementById('newGlassManufacturerName').value = '';
                } catch (error) {
                    window.alert(error.message);
                }
            });

            document.getElementById('saveCompatibleModelBtn').addEventListener('click', async function () {
                const name = modelName.value.trim();
                const manufacturerId = compatibleManufacturer.value;
                modelError.classList.add('d-none');
                if (!manufacturerId || !name) {
                    modelError.textContent = !manufacturerId
                        ? 'Select a compatible phone manufacturer first.'
                        : 'Enter a model name.';
                    modelError.classList.remove('d-none');
                    return;
                }

                try {
                    const response = await fetch('?handler=CreateModel', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            ...(antiforgeryToken ? { RequestVerificationToken: antiforgeryToken } : {})
                        },
                        body: new URLSearchParams({ manufacturerId, name })
                    });
                    const result = await response.json();
                    if (!response.ok) throw new Error(result.error || 'Could not create the model.');
                    compatibleModel.appendChild(new Option(result.name, result.id, true, true));
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('addCompatibleModelModal')).hide();
                    modelName.value = '';
                } catch (error) {
                    modelError.textContent = error.message;
                    modelError.classList.remove('d-none');
                }
            });
        });
    </script>
}
