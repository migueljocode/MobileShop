@page
@model MobileShop.Web.Pages.Products.CreatePhoneModel
@{
    ViewData["Title"] = "Create phone";
}

<h1>Create phone</h1>

<form method="post" class="row g-3 col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Input.ManufacturerId" class="form-label">Manufacturer</label>
        <div class="input-group">
            <select asp-for="Input.ManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, "Id", "Name"))" class="form-select" id="manufacturerSelect">
                <option value="">-- Select manufacturer --</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addManufacturerModal">Add New</button>
        </div>
        <span asp-validation-for="Input.ManufacturerId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.ModelId" class="form-label">Model</label>
        <div class="input-group">
            <select asp-for="Input.ModelId" asp-items="@(new SelectList(Model.Models, "Id", "Name"))" class="form-select" id="modelSelect">
                <option value="">-- Select model --</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addModelModal" id="addModelBtn">Add New</button>
        </div>
        <span asp-validation-for="Input.ModelId" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.Price" class="form-label">Paid price (IRR)</label>
        <input asp-for="Input.Price" class="form-control" data-price inputmode="numeric" step="1" min="0" max="@MobileShop.Models.MoneyLimits.MaxRials" />
        <span asp-validation-for="Input.Price" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.ProfitPercent" class="form-label">Profit %</label>
        <div class="input-group">
            <input asp-for="Input.ProfitPercent" class="form-control" data-percent />
            <span class="input-group-text">%</span>
        </div>
        <span asp-validation-for="Input.ProfitPercent" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.ProfitAmount" class="form-label">Profit amount (IRR)</label>
        <div class="input-group">
            <span class="input-group-text">IRR</span>
            <input asp-for="Input.ProfitAmount" class="form-control" data-amount inputmode="numeric" step="1" min="0" max="@MobileShop.Models.MoneyLimits.MaxRials" />
        </div>
        <span asp-validation-for="Input.ProfitAmount" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label class="form-label">Finished price (IRR)</label>
        <input type="text" class="form-control" data-finished-price readonly aria-readonly="true"
               tabindex="-1" style="background:#e9ecef;" />
        <span class="form-text text-muted">Server-stored price (paid + profit).</span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.ColorId" class="form-label"></label>
        <div class="input-group">
            <select asp-for="Input.ColorId" asp-items="@(new SelectList(Model.Colors, "Id", "Name"))" class="form-select" id="colorSelect">
                <option value="">-- Select color --</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addColorModal" id="addColorBtn">Add New</button>
        </div>
        <span asp-validation-for="Input.ColorId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.PartNumberId" class="form-label">Part number</label>
        <div class="input-group">
            <select asp-for="Input.PartNumberId" asp-items="@(new SelectList(Model.PartNumbers, "Id", "Name"))" class="form-select" id="partNumberSelect">
                <option value="">-- Select part number --</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addPartNumberModal">Add New</button>
        </div>
        <span asp-validation-for="Input.PartNumberId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.IMEI1" class="form-label"></label>
        <input asp-for="Input.IMEI1" class="form-control" />
        <span asp-validation-for="Input.IMEI1" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.IMEI2" class="form-label"></label>
        <input asp-for="Input.IMEI2" class="form-control" />
        <span asp-validation-for="Input.IMEI2" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <div class="form-check mt-4">
            <input asp-for="Input.SupportsDualSim" class="form-check-input" />
            <label asp-for="Input.SupportsDualSim" class="form-check-label">Dual SIM</label>
        </div>
    </div>

    <div class="col-md-3">
        <div class="form-check mt-4">
            <input asp-for="Input.SupportsEsim" class="form-check-input" />
            <label asp-for="Input.SupportsEsim" class="form-check-label">eSIM</label>
        </div>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="Input.IsSecondHand" class="form-check-input" data-second-hand-toggle />
            <label asp-for="Input.IsSecondHand" class="form-check-label">Second-hand item</label>
        </div>
    </div>

    <div class="col-12" data-second-hand-block style="display:none;">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.TestPeriodDays" class="form-label">Second-hand test days</label>
                <input asp-for="Input.TestPeriodDays" class="form-control" />
                <span asp-validation-for="Input.TestPeriodDays" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.SecondHandNotes" class="form-label">Second-hand notes</label>
                <input asp-for="Input.SecondHandNotes" class="form-control" />
                <span asp-validation-for="Input.SecondHandNotes" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="Input.HasGuarantee" class="form-check-input" data-guarantee-toggle />
            <label asp-for="Input.HasGuarantee" class="form-check-label">Has guarantee</label>
        </div>
    </div>

    <div class="col-12" data-guarantee-block style="display:none;">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.GuaranteeCorporation" class="form-label">Guarantee corporation</label>
                <div class="input-group">
                    <select asp-for="Input.GuaranteeCorporation" asp-items="@(new SelectList(Model.Corporations))" class="form-select" id="corporationSelect">
                        <option value="">-- Select corporation --</option>
                    </select>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addCorporationModal">Add New</button>
                </div>
                <span asp-validation-for="Input.GuaranteeCorporation" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.GuaranteeExpiry" class="form-label">Guarantee expiry</label>
                <input asp-for="Input.GuaranteeExpiry" class="form-control" />
                <span asp-validation-for="Input.GuaranteeExpiry" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.GuaranteeNotes" class="form-label">Guarantee notes</label>
                <input asp-for="Input.GuaranteeNotes" class="form-control" />
                <span asp-validation-for="Input.GuaranteeNotes" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="col-12">
        <button class="btn btn-primary" type="submit">Save phone</button>
        <a asp-page="/Products/Index" class="btn btn-outline-secondary ms-2">Back to products</a>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-danger mt-3">@Model.Message</div>
}

<!-- Add Manufacturer Modal -->
<div class="modal fade" id="addManufacturerModal" tabindex="-1" aria-labelledby="addManufacturerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addManufacturerModalLabel">Add Manufacturer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newManufacturerName" class="form-label">Name</label>
                    <input type="text" class="form-control" id="newManufacturerName" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveManufacturerBtn">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Model Modal -->
<div class="modal fade" id="addModelModal" tabindex="-1" aria-labelledby="addModelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addModelModalLabel">Add Model</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newModelName" class="form-label">Name</label>
    <div class="modal fade" id="addCorporationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add corporation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="text" class="form-control" id="newCorporationName" placeholder="Corporation" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="saveCorporationBtn">Save</button>
                </div>
            </div>
        </div>
    </div>

                    <input type="text" class="form-control" id="newModelName" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveModelBtn">Save</button>
            </div>
        </div>
        </div>
</div>

<!-- Add Color Modal -->
<div class="modal fade" id="addColorModal" tabindex="-1" aria-labelledby="addColorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addColorModalLabel">Add Color</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newColorName" class="form-label">Name</label>
                    <input type="text" class="form-control" id="newColorName" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveColorBtn">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addPartNumberModal" tabindex="-1" aria-labelledby="addPartNumberModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addPartNumberModalLabel">Add part number</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newPartNumberCode" class="form-label">Code</label>
                    <input type="text" class="form-control" id="newPartNumberCode" placeholder="e.g. CH/ZAA">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="savePartNumberBtn">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-product-pricing.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Conditional second-hand / guarantee blocks: visible only while their toggle is ticked.
            const secondHandToggle = document.querySelector('[data-second-hand-toggle]');
            const secondHandBlock = document.querySelector('[data-second-hand-block]');
            const guaranteeToggle = document.querySelector('[data-guarantee-toggle]');
            const guaranteeBlock = document.querySelector('[data-guarantee-block]');

            function syncSecondHand() {
                if (secondHandBlock) secondHandBlock.style.display = secondHandToggle.checked ? '' : 'none';
            }
            function syncGuarantee() {
                if (guaranteeBlock) guaranteeBlock.style.display = guaranteeToggle.checked ? '' : 'none';
            }

            if (secondHandToggle) {
                secondHandToggle.addEventListener('change', syncSecondHand);
                syncSecondHand();
            }
            if (guaranteeToggle) {
                guaranteeToggle.addEventListener('change', syncGuarantee);
                syncGuarantee();
            }

            const manufacturerSelect = document.getElementById('manufacturerSelect');
            const modelSelect = document.getElementById('modelSelect');

            manufacturerSelect.addEventListener('change', async function () {
                const manufacturerId = this.value;
                modelSelect.innerHTML = '<option value="">-- Select model --</option>';
                if (manufacturerId) {
                    try {
                        const response = await fetch(`/Products/CreatePhone?handler=Models&manufacturerId=${manufacturerId}`);
                        if (response.ok) {
                            const models = await response.json();
                            models.forEach(m => {
                                const opt = document.createElement('option');
                                opt.value = m.id;
                                opt.textContent = m.name;
                                modelSelect.appendChild(opt);
                            });
                        }
                    } catch (error) { console.error('Error loading models:', error); }
                }
            });

            const partNumberSelect = document.getElementById('partNumberSelect');

            // Reloading part numbers whenever the model changes keeps the combobox scoped to the
            // currently selected model instead of showing another model's part numbers.
            modelSelect.addEventListener('change', async function () {
                const modelId = this.value;
                partNumberSelect.innerHTML = '<option value="">-- Select part number --</option>';
                if (modelId) {
                    try {
                        const response = await fetch(`/Products/CreatePhone?handler=PartNumbers&modelId=${modelId}`);
                        if (response.ok) {
                            const parts = await response.json();
                            parts.forEach(p => {
                                const opt = document.createElement('option');
                                opt.value = p.id;
                                opt.textContent = p.name;
                                partNumberSelect.appendChild(opt);
                            });
                        }
                    } catch (error) { console.error('Error loading part numbers:', error); }
                }
            });

            document.getElementById('savePartNumberBtn').addEventListener('click', async function () {
                const code = document.getElementById('newPartNumberCode').value.trim();
                const modelId = modelSelect.value;
                if (!code || !modelId) return;
                try {
                    const response = await fetch('/Products/CreatePhone?handler=CreatePartNumber', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ modelId: Number(modelId), code })
                    });
                    if (response.ok) {
                        const result = await response.json();
                        const opt = document.createElement('option');
                        opt.value = result.id;
                        opt.textContent = result.name;
                        partNumberSelect.appendChild(opt);
                        partNumberSelect.value = result.id;
                        bootstrap.Modal.getInstance(document.getElementById('addPartNumberModal')).hide();
                        document.getElementById('newPartNumberCode').value = '';
                    } else {
                        const err = await response.json();
                        console.error('Error creating part number:', err.error);
                    }
                } catch (error) { console.error('Error creating part number:', error); }
            });

            document.getElementById('saveManufacturerBtn').addEventListener('click', async function () {
                const name = document.getElementById('newManufacturerName').value.trim();
                if (!name) return;
                try {
                    const response = await fetch('/Products/CreatePhone?handler=CreateManufacturer', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name })
                    });
                    if (response.ok) {
                        const result = await response.json();
                        const opt = document.createElement('option');
                        opt.value = result.id;
                        opt.textContent = result.name;
                        manufacturerSelect.appendChild(opt);
                        manufacturerSelect.value = result.id;
                        manufacturerSelect.dispatchEvent(new Event('change'));
                        bootstrap.Modal.getInstance(document.getElementById('addManufacturerModal')).hide();
                        document.getElementById('newManufacturerName').value = '';
                    }
                } catch (error) { console.error('Error creating manufacturer:', error); }
            });

            document.getElementById('saveModelBtn').addEventListener('click', async function () {
                const name = document.getElementById('newModelName').value.trim();
                const manufacturerId = manufacturerSelect.value;
                if (!name || !manufacturerId) return;
                try {
                    const response = await fetch(`/Products/CreatePhone?handler=CreateModel&manufacturerId=${manufacturerId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name })
                    });
                    if (response.ok) {
                        const result = await response.json();
                        const opt = document.createElement('option');
                        opt.value = result.id;
                        opt.textContent = result.name;
                        modelSelect.appendChild(opt);
                        modelSelect.value = result.id;
                        bootstrap.Modal.getInstance(document.getElementById('addModelModal')).hide();
                        document.getElementById('newModelName').value = '';
                    }
                } catch (error) { console.error('Error creating model:', error); }
            });

            const colorSelect = document.getElementById('colorSelect');
            document.getElementById('saveColorBtn').addEventListener('click', async function () {
                const name = document.getElementById('newColorName').value.trim();
                if (!name) return;
                try {
                    const response = await fetch('/Products/CreatePhone?handler=CreateColor', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name })
                    });
                    if (response.ok) {
                        const result = await response.json();
                        const opt = document.createElement('option');
                        opt.value = result.id;
                        opt.textContent = result.name;
                        colorSelect.appendChild(opt);
                        colorSelect.value = result.id;
                        bootstrap.Modal.getInstance(document.getElementById('addColorModal')).hide();
                        document.getElementById('newColorName').value = '';
                    }
                } catch (error) { console.error('Error creating color:', error); }
            });

            const corporationSelect = document.getElementById('corporationSelect');
            document.getElementById('saveCorporationBtn').addEventListener('click', async function () {
                const name = document.getElementById('newCorporationName').value.trim();
                if (!name) return;
                try {
                    const response = await fetch('/Products/CreatePhone?handler=CreateCorporation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name })
                    });
                    if (response.ok) {
                        const result = await response.json();
                        const opt = document.createElement('option');
                        opt.value = result.name;
                        opt.textContent = result.name;
                        corporationSelect.appendChild(opt);
                        corporationSelect.value = result.name;
                        bootstrap.Modal.getInstance(document.getElementById('addCorporationModal')).hide();
                        document.getElementById('newCorporationName').value = '';
                    }
                } catch (error) { console.error('Error creating corporation:', error); }
            });
        });
    </script>
}
