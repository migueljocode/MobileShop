@page
@model MobileShop.Web.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Product details";
}

@if (Model.Product is not null)
{
    <h1>@Model.Product.Manufacturer @Model.Product.Model</h1>
    <p><strong>Type:</strong> @Model.Product.Type</p>
    <dl class="row">
        <dt class="col-sm-3">Identifier</dt><dd class="col-sm-9">@Model.Product.Identifier</dd>
        <dt class="col-sm-3">Color</dt><dd class="col-sm-9">@(Model.Product.Color ?? "—")</dd>
        <dt class="col-sm-3">Owner</dt><dd class="col-sm-9">@Model.Product.OwnerLabel</dd>
        <dt class="col-sm-3">Second-hand</dt><dd class="col-sm-9">@(Model.Product.IsSecondHand ? "Yes" : "No")</dd>
        <dt class="col-sm-3">Guarantee</dt><dd class="col-sm-9">@Model.Product.GuaranteeLabel</dd>
    </dl>
    <h2>Transactions</h2>
    @if (Model.Transactions.Count == 0) { <p class="text-muted">No transactions.</p> }
    else
    {
        <table class="table"><thead><tr><th>Date</th><th>Direction</th><th>Price</th><th>Seller</th><th>Customer</th></tr></thead>
        <tbody>@foreach (var transaction in Model.Transactions)
        { <tr><td>@transaction.Date.ToString("yyyy-MM-dd")</td><td>@transaction.Direction</td><td>@transaction.FinishedPrice.ToString("N0")</td><td>@transaction.SellerLabel</td><td>@transaction.CustomerLabel</td></tr> }</tbody></table>
    }
}
