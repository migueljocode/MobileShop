@page
@using MobileShop.Models.Extensions
@model MobileShop.Web.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Product details";
}

@if (Model.Product is not null)
{
    <a asp-page="/Products/Index" asp-route-type="@(Model.Product.Type == "Apple ID" ? "appleid" : "phone")" class="btn btn-outline-secondary mb-3">Back to Products</a>
    <h1>@Model.Product.Manufacturer @Model.Product.Model</h1>
    <p><strong>Type:</strong> @Model.Product.Type</p>
    <dl class="row">
        <dt class="col-sm-3">Identifier</dt><dd class="col-sm-9">@Model.Product.Identifier</dd>
        <dt class="col-sm-3">Color</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Product.Color) ? "N/A" : Model.Product.Color)</dd>
        <dt class="col-sm-3">Owner</dt><dd class="col-sm-9">@Model.Product.OwnerLabel</dd>
        <dt class="col-sm-3">Second-hand</dt><dd class="col-sm-9">@(Model.Product.IsSecondHand ? "Yes" : "No")</dd>
        <dt class="col-sm-3">Guarantee</dt><dd class="col-sm-9">@Model.Product.GuaranteeLabel</dd>
        @if (Model.Product.Type == "Phone")
        {
            <dt class="col-sm-3">Part number</dt><dd class="col-sm-9">@Model.Product.PartNumberLabel</dd>
            <dt class="col-sm-3">Dual SIM</dt><dd class="col-sm-9">@Model.Product.DualSimLabel</dd>
            <dt class="col-sm-3">eSIM</dt><dd class="col-sm-9">@Model.Product.EsimLabel</dd>
        }
    </dl>
    <h2>Transactions</h2>
    @if (Model.Transactions.Count == 0) { <p class="text-muted">No transactions.</p> }
    else
    {
        <table class="table"><thead><tr><th>Date</th><th>Direction</th><th>Price (IRR)</th><th>Seller</th><th>Customer</th></tr></thead>
        <tbody>@foreach (var transaction in Model.Transactions)
        { <tr><td>@transaction.Date.ToString("yyyy-MM-dd")</td><td>@transaction.Direction</td><td>@transaction.FinishedPrice.ToIrr()</td><td>@transaction.SellerLabel</td><td>@transaction.CustomerLabel</td></tr> }</tbody></table>
    }
}
