@page
@model MobileShop.Web.Pages.Products.CreateChargerModel
@{ ViewData["Title"] = "Create charger"; }
<h1>Create charger</h1>
<form id="productCreateForm" method="post" class="row g-3 col-lg-8 mx-auto">
    <partial name="/Pages/Shared/_ProductSellerPicker.cshtml" />
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-6"><label asp-for="Input.ManufacturerId" class="form-label">Manufacturer</label><div class="input-group"><select asp-for="Input.ManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, "Id", "Name"))" class="form-select" id="manufacturerSelect"><option value="">-- Select manufacturer --</option></select><button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addManufacturerModal">Add New</button></div></div>
<div class="col-md-6"><label asp-for="Input.ModelId" class="form-label">Model</label><div class="input-group"><select asp-for="Input.ModelId" asp-items="@(new SelectList(Model.Models, "Id", "Name"))" class="form-select" id="modelSelect"><option value="">-- Select model --</option></select><button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addModelModal">Add New</button></div></div>
<div class="col-md-4"><label asp-for="Input.Wattage">Wattage</label><input asp-for="Input.Wattage" class="form-control" min="0" /></div><div class="col-md-4"><label asp-for="Input.PortCount">Ports</label><input asp-for="Input.PortCount" class="form-control" min="1" /></div><div class="col-md-4"><div class="form-check mt-4"><input asp-for="Input.Pd" class="form-check-input" /><label asp-for="Input.Pd" class="form-check-label">USB Power Delivery</label></div></div>
<div class="col-md-3"><label asp-for="Input.Price">Paid price (Toman)</label><input asp-for="Input.Price" class="form-control" data-price inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" /></div><div class="col-md-3"><label asp-for="Input.ProfitPercent">Profit %</label><input asp-for="Input.ProfitPercent" class="form-control" data-percent /></div><div class="col-md-3"><label asp-for="Input.ProfitAmount">Profit amount (Toman)</label><input asp-for="Input.ProfitAmount" class="form-control" data-amount inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" /></div><div class="col-md-3"><label>Finished price (Toman)</label><input class="form-control" data-finished-price readonly /></div>
<div class="col-md-4"><label asp-for="Input.Count">Count</label><input asp-for="Input.Count" class="form-control" min="1" /></div>
</form>
<div class="d-flex flex-wrap gap-2 mt-3"><button class="btn btn-primary" type="submit" form="productCreateForm">Save charger</button><a asp-page="/Products/Index" class="btn btn-outline-secondary">Back to products</a></div>
<partial name="/Pages/Shared/_ProductCreateSuccess.cshtml" model="Model.SuccessMessage" />
@if (!string.IsNullOrWhiteSpace(Model.Message)){<div class="alert alert-danger mt-3">@Model.Message</div>}
<div class="modal fade" id="addManufacturerModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Add Manufacturer</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div id="manufacturerModalError" class="alert alert-danger d-none" role="alert"></div><label for="newManufacturerName" class="form-label">Name</label><input type="text" class="form-control" id="newManufacturerName" required /></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveManufacturerBtn">Save</button></div></div></div></div>
<div class="modal fade" id="addModelModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Add Model</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div id="modelModalError" class="alert alert-danger d-none" role="alert"></div><label for="newModelName" class="form-label">Name</label><input type="text" class="form-control" id="newModelName" required /></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveModelBtn">Save</button></div></div></div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-product-pricing.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const manufacturer = document.getElementById('manufacturerSelect');
            const model = document.getElementById('modelSelect');
            const manufacturerError = document.getElementById('manufacturerModalError');
            const modelError = document.getElementById('modelModalError');
            const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const postHandler = async (handler, values) => {
                if (!antiforgeryToken) throw new Error('The security token is missing. Refresh the page and try again.');
                const response = await fetch(`?handler=${handler}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        RequestVerificationToken: antiforgeryToken
                    },
                    body: new URLSearchParams({ ...values, __RequestVerificationToken: antiforgeryToken })
                });
                if (!(response.headers.get('content-type') || '').includes('application/json')) {
                    throw new Error(`The server returned an unexpected response (HTTP ${response.status}). Refresh the page and try again.`);
                }
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'The request could not be completed.');
                return result;
            };

            const loadModels = async () => {
                model.replaceChildren(new Option('-- Select model --', ''));
                if (!manufacturer.value) return;
                const response = await fetch(`?handler=Models&manufacturerId=${encodeURIComponent(manufacturer.value)}`);
                if (!response.ok) throw new Error('Could not load models for this manufacturer.');
                const models = await response.json();
                models.forEach(item => model.appendChild(new Option(item.name, item.id)));
            };

            manufacturer.addEventListener('change', async () => {
                try {
                    await loadModels();
                    modelError.classList.add('d-none');
                } catch (error) {
                    modelError.textContent = error.message;
                    modelError.classList.remove('d-none');
                }
            });

            document.getElementById('saveManufacturerBtn').addEventListener('click', async () => {
                const nameInput = document.getElementById('newManufacturerName');
                const name = nameInput.value.trim();
                manufacturerError.classList.add('d-none');
                if (!name) {
                    manufacturerError.textContent = 'Enter a manufacturer name.';
                    manufacturerError.classList.remove('d-none');
                    return;
                }
                try {
                    const result = await postHandler('CreateManufacturer', { name });
                    manufacturer.appendChild(new Option(result.name, result.id, true, true));
                    manufacturer.value = result.id;
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('addManufacturerModal')).hide();
                    nameInput.value = '';
                    await loadModels();
                } catch (error) {
                    manufacturerError.textContent = error.message;
                    manufacturerError.classList.remove('d-none');
                }
            });

            document.getElementById('saveModelBtn').addEventListener('click', async () => {
                const nameInput = document.getElementById('newModelName');
                const name = nameInput.value.trim();
                modelError.classList.add('d-none');
                if (!manufacturer.value || !name) {
                    modelError.textContent = !manufacturer.value ? 'Select a manufacturer first.' : 'Enter a model name.';
                    modelError.classList.remove('d-none');
                    return;
                }
                try {
                    const result = await postHandler('CreateModel', { manufacturerId: manufacturer.value, name });
                    model.appendChild(new Option(result.name, result.id, true, true));
                    model.value = result.id;
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('addModelModal')).hide();
                    nameInput.value = '';
                } catch (error) {
                    modelError.textContent = error.message;
                    modelError.classList.remove('d-none');
                }
            });
        });
    </script>
}