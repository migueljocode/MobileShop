@page
@model MobileShop.Web.Pages.Products.CreateCaseModel
@{
    ViewData["Title"] = "Create case";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Create case</h1>
    </div>
</div>

<form id="productCreateForm" method="post" class="row g-3 col-lg-7 mx-auto">
    <partial name="/Pages/Shared/_ProductSellerPicker.cshtml" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-section col-12">
        <h2 class="form-section__title">Product</h2>
        <div class="row g-3">
            <div class="col-12">
                <div class="glass-fit-header">
                    <span id="glassFitLabel" class="form-label mb-0">Compatible phones</span>
                    <button type="button" id="openCompatiblePhoneModal" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addCompatiblePhoneModal">
                        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M8 3.25v9.5M3.25 8h9.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                        Add phone
                    </button>
                </div>
                <ul id="glassFitList" class="glass-fit-list" aria-labelledby="glassFitLabel">
                    @foreach (var fit in Model.SelectedFits)
                    {
                        <partial name="/Pages/Shared/_GlassFitListItem.cshtml" model="fit" />
                    }
                </ul>
                <template id="glassFitTemplate">
                    <partial name="/Pages/Shared/_GlassFitListItem.cshtml" model="Model.FitTemplate" />
                </template>
                <p id="glassFitEmpty" class="glass-fit-empty mt-2"@(Model.SelectedFits.Count > 0 ? " hidden" : "")>No phones added yet.</p>
                <span id="glassFitValidation" class="text-danger d-block"></span>
                <span asp-validation-for="Input.CompatibleModelIds" class="text-danger d-block"></span>
                <div id="glassFitLive" class="visually-hidden" aria-live="polite"></div>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.ManufacturerId" class="form-label">Case manufacturer</label>
                <div class="input-group">
                    <select asp-for="Input.ManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, "Id", "Name"))" class="form-select" id="caseManufacturerSelect">
                        <option value="">-- Select case manufacturer --</option>
                    </select>
                    <button type="button" class="btn btn-outline-secondary input-group-add-icon" data-bs-toggle="modal" data-bs-target="#addCaseManufacturerModal" aria-label="Add case manufacturer" title="Add case manufacturer"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.25v9.5M3.25 8h9.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
                </div>
                <span asp-validation-for="Input.ManufacturerId" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-section col-12">
        <h2 class="form-section__title">Pricing</h2>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Input.Price" class="form-label">Paid price (Toman)</label>
                <input asp-for="Input.Price" class="form-control" data-price inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" />
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.ProfitPercent" class="form-label">Profit %</label>
                <div class="input-group">
                    <input asp-for="Input.ProfitPercent" class="form-control" data-percent />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="Input.ProfitPercent" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.ProfitAmount" class="form-label">Profit amount (Toman)</label>
                <input asp-for="Input.ProfitAmount" class="form-control" data-amount inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" />
                <span asp-validation-for="Input.ProfitAmount" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="finished-price">Finished price (Toman)</label>
                <input type="text" class="form-control" id="finished-price" data-finished-price readonly aria-readonly="true" tabindex="-1" />
                <span class="form-text text-muted">Server-stored price (paid + profit).</span>
            </div>
        </div>
    </div>

    <div class="form-section col-12">
        <h2 class="form-section__title">Case details</h2>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Input.Notes" class="form-label">Notes</label>
                <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Notes" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Count" class="form-label">Count</label>
                <input asp-for="Input.Count" class="form-control" min="1" />
                <span asp-validation-for="Input.Count" class="text-danger"></span>
            </div>
        </div>
    </div>
</form>
<div class="action-bar action-bar--static">
    <button class="btn btn-primary" type="submit" form="productCreateForm">Save case</button>
    <a asp-page="/Products/Index" class="btn btn-outline-secondary">Cancel</a>
</div>

<partial name="/Pages/Shared/_ProductCreateSuccess.cshtml" model="Model.SuccessMessage" />

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-danger mt-3" role="alert">@Model.Message</div>
}

<div class="modal fade" id="addCaseManufacturerModal" tabindex="-1" aria-labelledby="addCaseManufacturerModal-title" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="addCaseManufacturerModal-title">Add Case Manufacturer</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><label for="newCaseManufacturerName" class="form-label">Name</label><input type="text" class="form-control" id="newCaseManufacturerName" required /></div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveCaseManufacturerBtn">Save</button></div>
    </div></div>
</div>

<div class="modal fade" id="addCompatiblePhoneModal" tabindex="-1" aria-labelledby="addCompatiblePhoneModal-title" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="addCompatiblePhoneModal-title">Add compatible phone</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            <div id="compatiblePhoneError" class="alert alert-danger d-none" role="alert"></div>

            <label for="compatiblePhoneManufacturer" class="form-label">Manufacturer</label>
            <div class="input-group">
                <select id="compatiblePhoneManufacturer" class="form-select"><option value="">-- Select manufacturer --</option>@foreach (var option in Model.Manufacturers) { <option value="@option.Id">@option.Name</option> }</select>
                <button type="button" class="btn btn-outline-secondary input-group-add-icon" id="showNewPhoneManufacturer" aria-label="New manufacturer" title="New manufacturer"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.25v9.5M3.25 8h9.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
            </div>
            <div id="newPhoneManufacturerRow" class="input-group mt-2 d-none">
                <input type="text" class="form-control" id="newPhoneManufacturerName" placeholder="Manufacturer name" aria-label="New manufacturer name" />
                <button type="button" class="btn btn-outline-secondary" id="saveNewPhoneManufacturer">Save</button>
            </div>

            <label for="compatiblePhoneModel" class="form-label mt-3">Model</label>
            <div class="input-group">
                <select id="compatiblePhoneModel" class="form-select" disabled><option value="">-- Select manufacturer first --</option></select>
                <button type="button" class="btn btn-outline-secondary input-group-add-icon" id="showNewPhoneModel" aria-label="New model" title="New model"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.25v9.5M3.25 8h9.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
            </div>
            <div id="newPhoneModelRow" class="input-group mt-2 d-none">
                <input type="text" class="form-control" id="newPhoneModelName" placeholder="Model name" aria-label="New model name" />
                <button type="button" class="btn btn-outline-secondary" id="saveNewPhoneModel">Save</button>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="addCompatiblePhoneBtn" disabled>Add</button>
        </div>
    </div></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-product-pricing.js"></script>
    <script src="~/js/create-glass-fits.js"></script>
}
