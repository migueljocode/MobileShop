@page
@model MobileShop.Web.Pages.Products.CreateCaseModel
@{ ViewData["Title"] = "Create case"; }
<h1>Create case</h1>
<form method="post" class="row g-3 col-lg-8">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-6"><label asp-for="Input.ManufacturerId">Case manufacturer</label><select asp-for="Input.ManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, "Id", "Name"))" class="form-select"><option value="">-- Select manufacturer --</option></select></div>
<div class="col-md-6"><label asp-for="Input.CompatibleManufacturerId">Compatible phone manufacturer</label><select asp-for="Input.CompatibleManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, "Id", "Name"))" class="form-select" id="compatibleManufacturerSelect"><option value="">-- Select manufacturer --</option></select></div>
<div class="col-12"><label asp-for="Input.CompatibleModelIds">Compatible phone models</label><select asp-for="Input.CompatibleModelIds" asp-items="@(new SelectList(Model.CompatibleModels, "Id", "Name"))" class="form-select" id="compatibleModelSelect" multiple></select><span class="form-text">Select one or more compatible phone models.</span></div>
<div class="col-md-3"><label asp-for="Input.Price">Paid price (IRR)</label><input asp-for="Input.Price" class="form-control" data-price inputmode="numeric" step="1" min="0" max="@MobileShop.Models.MoneyLimits.MaxRials" /></div><div class="col-md-3"><label asp-for="Input.ProfitPercent">Profit %</label><input asp-for="Input.ProfitPercent" class="form-control" data-percent /></div><div class="col-md-3"><label asp-for="Input.ProfitAmount">Profit amount (IRR)</label><input asp-for="Input.ProfitAmount" class="form-control" data-amount inputmode="numeric" step="1" min="0" max="@MobileShop.Models.MoneyLimits.MaxRials" /></div><div class="col-md-3"><label>Finished price (IRR)</label><input class="form-control" data-finished-price readonly /></div>
<div class="col-md-4"><label asp-for="Input.Count">Count</label><input asp-for="Input.Count" class="form-control" min="1" /></div>
<div class="col-12"><button class="btn btn-primary" type="submit">Save case</button><a asp-page="/Products/Index" class="btn btn-outline-secondary ms-2">Back to products</a></div>
</form>
@if (!string.IsNullOrWhiteSpace(Model.Message)){<div class="alert alert-danger mt-3">@Model.Message</div>}
@section Scripts{<partial name="_ValidationScriptsPartial" /><script src="~/js/create-product-pricing.js"></script><script>
document.addEventListener('DOMContentLoaded',function(){const m=document.getElementById('compatibleManufacturerSelect'),s=document.getElementById('compatibleModelSelect');m?.addEventListener('change',async function(){s.innerHTML='';if(!this.value)return;const r=await fetch('?handler=CompatibleModels&manufacturerId='+encodeURIComponent(this.value));if(r.ok)(await r.json()).forEach(x=>s.appendChild(new Option(x.name,x.id)))})});
</script>}