@page
@model MobileShop.Web.Pages.Products.SecondHandModel
@{
    ViewData["Title"] = "Second-hand";
}

<div class="page-head"><div><h1 class="page-head__title">Second-hand items</h1><p class="page-head__sub">Total items: @Model.Products.Count</p></div><div class="page-head__actions"><a asp-page="/Products/Index" class="btn btn-outline-secondary">Back to products</a></div></div>

@if (Model.Products.Count == 0)
{
    <partial name="_EmptyState" model='("No second-hand items are currently listed", "Add a second-hand product to see it here.")' />
}
else
{
    <div class="table-responsive">
    <table class="data-table">
        <thead>
            <tr>
                <th scope="col">Type</th>
                <th scope="col">Product</th>
                <th scope="col">Identifier</th>
                <th scope="col">Color</th>
                <th scope="col">Status</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Type</td>
                    <td dir="auto">@product.Name</td>
                    <td dir="auto" class="num">@product.Identifier</td>
                    <td dir="auto">@(string.IsNullOrWhiteSpace(product.Color) ? "N/A" : product.Color)</td>
                    <td>
                        <span class="status-chip status-chip--@(product.IsSold ? "sold" : "available")">@(product.IsSold ? "Sold" : "Available")</span>
                        <span class="status-chip status-chip--used ms-1">Second-hand</span>
                    </td>
                    <td><a asp-page="/Products/Details" asp-route-id="@product.EntityId" asp-route-type="@product.Type.ToLowerInvariant().Replace(" ", "")">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
