@page
@model MobileShop.Web.Pages.Products.CreateTabletModel
@{ ViewData["Title"] = "Create tablet"; }
<h1>Create tablet</h1>
<form method="post" class="row g-3 col-lg-8">
    <partial name="/Pages/Shared/_ProductSellerPicker.cshtml" />
<div asp-validation-summary="All" class="text-danger"></div>
<div class="col-md-6">
    <label asp-for="Input.ManufacturerId" class="form-label">Manufacturer</label>
    <div class="input-group">
        <select asp-for="Input.ManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, "Id", "Name"))" class="form-select" id="manufacturerSelect"><option value="">-- Select manufacturer --</option></select>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addManufacturerModal">Add New</button>
    </div>
</div>
<div class="col-md-6">
    <label asp-for="Input.ModelId" class="form-label">Model</label>
    <div class="input-group">
        <select asp-for="Input.ModelId" asp-items="@(new SelectList(Model.Models, "Id", "Name"))" class="form-select" id="modelSelect"><option value="">-- Select model --</option></select>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addModelModal" id="addModelBtn">Add New</button>
    </div>
</div>

<div class="col-md-3"><label asp-for="Input.Price" class="form-label">Paid price (IRR)</label><input asp-for="Input.Price" class="form-control" data-price inputmode="numeric" step="1" min="0" max="@MobileShop.Models.MoneyLimits.MaxRials" /></div>
<div class="col-md-3"><label asp-for="Input.ProfitPercent" class="form-label">Profit %</label><input asp-for="Input.ProfitPercent" class="form-control" data-percent /></div>
<div class="col-md-3"><label asp-for="Input.ProfitAmount" class="form-label">Profit amount (IRR)</label><input asp-for="Input.ProfitAmount" class="form-control" data-amount inputmode="numeric" step="1" min="0" max="@MobileShop.Models.MoneyLimits.MaxRials" /></div>
<div class="col-md-3"><label class="form-label">Finished price (IRR)</label><input class="form-control" data-finished-price readonly /></div>
<div class="col-12"><div class="form-check"><input asp-for="Input.IsSecondHand" class="form-check-input" data-second-hand-toggle /><label asp-for="Input.IsSecondHand" class="form-check-label">Second-hand item</label></div></div>
<div class="col-12" data-second-hand-block style="display:none"><label asp-for="Input.TestPeriodDays">Second-hand test days</label><input asp-for="Input.TestPeriodDays" class="form-control" /><label asp-for="Input.SecondHandNotes">Second-hand notes</label><input asp-for="Input.SecondHandNotes" class="form-control" /></div>
<div class="col-12"><div class="form-check"><input asp-for="Input.HasGuarantee" class="form-check-input" data-guarantee-toggle /><label asp-for="Input.HasGuarantee" class="form-check-label">Has guarantee</label></div></div>
<div class="col-12" data-guarantee-block style="display:none"><label asp-for="Input.GuaranteeCorporation">Guarantee corporation</label><select asp-for="Input.GuaranteeCorporation" asp-items="@(new SelectList(Model.Corporations))" class="form-select"><option value="">-- Select corporation --</option></select><label asp-for="Input.GuaranteeExpiry">Guarantee expiry</label><input asp-for="Input.GuaranteeExpiry" class="form-control" type="date" /><label asp-for="Input.GuaranteeNotes">Guarantee notes</label><input asp-for="Input.GuaranteeNotes" class="form-control" /></div>
<div class="col-12"><label asp-for="Input.Notes">Device notes</label><textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea></div>
<div class="col-12"><button class="btn btn-primary" type="submit">Save tablet</button><a asp-page="/Products/Index" class="btn btn-outline-secondary ms-2">Back to products</a></div>
</form>
@if (!string.IsNullOrWhiteSpace(Model.Message)){<div class="alert alert-danger mt-3">@Model.Message</div>}

<div class="modal fade" id="addManufacturerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Add Manufacturer</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div id="manufacturerModalError" class="alert alert-danger d-none" role="alert"></div>
                <label for="newManufacturerName" class="form-label">Name</label>
                <input type="text" class="form-control" id="newManufacturerName" required />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveManufacturerBtn">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addModelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Add Model</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div id="modelModalError" class="alert alert-danger d-none" role="alert"></div>
                <label for="newModelName" class="form-label">Name</label>
                <input type="text" class="form-control" id="newModelName" required />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveModelBtn">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-product-pricing.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const manufacturer = document.getElementById('manufacturerSelect');
            const model = document.getElementById('modelSelect');
            const manufacturerError = document.getElementById('manufacturerModalError');
            const modelError = document.getElementById('modelModalError');
            const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const secondHandToggle = document.querySelector('[data-second-hand-toggle]');
            const secondHandBlock = document.querySelector('[data-second-hand-block]');
            const guaranteeToggle = document.querySelector('[data-guarantee-toggle]');
            const guaranteeBlock = document.querySelector('[data-guarantee-block]');

            const syncVisibility = (toggle, block) => {
                if (toggle && block) block.style.display = toggle.checked ? '' : 'none';
            };
            secondHandToggle?.addEventListener('change', () => syncVisibility(secondHandToggle, secondHandBlock));
            guaranteeToggle?.addEventListener('change', () => syncVisibility(guaranteeToggle, guaranteeBlock));
            syncVisibility(secondHandToggle, secondHandBlock);
            syncVisibility(guaranteeToggle, guaranteeBlock);

            const showError = (element, error) => {
                element.textContent = error.message;
                element.classList.remove('d-none');
            };

            const postHandler = async (handler, values) => {
                if (!antiforgeryToken) throw new Error('The security token is missing. Refresh the page and try again.');
                const response = await fetch(`?handler=${handler}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        RequestVerificationToken: antiforgeryToken
                    },
                    body: new URLSearchParams({ ...values, __RequestVerificationToken: antiforgeryToken })
                });
                if (!(response.headers.get('content-type') || '').includes('application/json')) {
                    throw new Error(`The server returned an unexpected response (HTTP ${response.status}). Refresh the page and try again.`);
                }
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'The request could not be completed.');
                return result;
            };

            const loadModels = async () => {
                model.replaceChildren(new Option('-- Select model --', ''));
                if (!manufacturer.value) return;
                const response = await fetch(`?handler=Models&manufacturerId=${encodeURIComponent(manufacturer.value)}`);
                if (!response.ok) throw new Error('Could not load models for this manufacturer.');
                const models = await response.json();
                models.forEach(item => model.appendChild(new Option(item.name, item.id)));
            };

            manufacturer.addEventListener('change', async () => {
                try {
                    await loadModels();
                    modelError.classList.add('d-none');
                } catch (error) {
                    showError(modelError, error);
                }
            });

            document.getElementById('saveManufacturerBtn').addEventListener('click', async () => {
                const nameInput = document.getElementById('newManufacturerName');
                const name = nameInput.value.trim();
                manufacturerError.classList.add('d-none');
                if (!name) {
                    showError(manufacturerError, new Error('Enter a manufacturer name.'));
                    return;
                }
                try {
                    const result = await postHandler('CreateManufacturer', { name });
                    manufacturer.appendChild(new Option(result.name, result.id, true, true));
                    manufacturer.value = result.id;
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('addManufacturerModal')).hide();
                    nameInput.value = '';
                    await loadModels();
                } catch (error) {
                    showError(manufacturerError, error);
                }
            });

            document.getElementById('saveModelBtn').addEventListener('click', async () => {
                const nameInput = document.getElementById('newModelName');
                const name = nameInput.value.trim();
                modelError.classList.add('d-none');
                if (!manufacturer.value || !name) {
                    showError(modelError, new Error(!manufacturer.value ? 'Select a manufacturer first.' : 'Enter a model name.'));
                    return;
                }
                try {
                    const result = await postHandler('CreateModel', { manufacturerId: manufacturer.value, name });
                    model.appendChild(new Option(result.name, result.id, true, true));
                    model.value = result.id;
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('addModelModal')).hide();
                    nameInput.value = '';
                } catch (error) {
                    showError(modelError, error);
                }
            });
        });
    </script>
}
