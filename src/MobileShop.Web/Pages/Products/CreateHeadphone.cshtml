@page
@model MobileShop.Web.Pages.Products.CreateHeadphoneModel
@{ ViewData["Title"] = "Create headphone"; }
<div class="page-head">
    <div>
        <h1 class="page-head__title">Create headphone</h1>
    </div>
</div>
<form id="productCreateForm" method="post" class="row g-3 col-lg-8 mx-auto">
    <partial name="/Pages/Shared/_ProductSellerPicker.cshtml" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-section col-12">
        <h2 class="form-section__title">Product</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.ManufacturerId" class="form-label">Manufacturer</label>
                <div class="input-group">
                    <select asp-for="Input.ManufacturerId" asp-items="@(new SelectList(Model.Manufacturers, "Id", "Name"))" class="form-select" id="manufacturerSelect">
                        <option value="">-- Select manufacturer --</option>
                    </select>
                    <button type="button" class="btn btn-outline-secondary input-group-add-icon" data-bs-toggle="modal" data-bs-target="#addManufacturerModal" aria-label="Add manufacturer" title="Add manufacturer">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.25v9.5M3.25 8h9.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Input.ManufacturerId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.ModelId" class="form-label">Model</label>
                <div class="input-group">
                    <select asp-for="Input.ModelId" asp-items="@(new SelectList(Model.Models, "Id", "Name"))" class="form-select" id="modelSelect">
                        <option value="">-- Select model --</option>
                    </select>
                    <button type="button" class="btn btn-outline-secondary input-group-add-icon" data-bs-toggle="modal" data-bs-target="#addModelModal" aria-label="Add model" title="Add model">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.25v9.5M3.25 8h9.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Input.ModelId" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-section col-12">
        <h2 class="form-section__title">Pricing</h2>
        <div class="row g-3">
            <div class="col-md-3"><label asp-for="Input.Price" class="form-label">Paid price (Toman)</label><input asp-for="Input.Price" class="form-control" data-price inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" /></div>
            <div class="col-md-3"><label asp-for="Input.ProfitPercent" class="form-label">Profit %</label><input asp-for="Input.ProfitPercent" class="form-control" data-percent /></div>
            <div class="col-md-3"><label asp-for="Input.ProfitAmount" class="form-label">Profit amount (Toman)</label><input asp-for="Input.ProfitAmount" class="form-control" data-amount inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" /></div>
            <div class="col-md-3"><label class="form-label" for="finished-price">Finished price (Toman)</label><input class="form-control" id="finished-price" data-finished-price readonly /></div>
        </div>
    </div>
    <div class="form-section col-12">
        <h2 class="form-section__title">Headphone details</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.Kind" class="form-label">Kind</label>
                <select asp-for="Input.Kind" asp-items="Html.GetEnumSelectList<MobileShop.Models.Enums.HeadphoneKind>()" class="form-select"></select>
                <span asp-validation-for="Input.Kind" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Connection" class="form-label">Connection</label>
                <select asp-for="Input.Connection" asp-items="Html.GetEnumSelectList<MobileShop.Models.Enums.HeadphoneConnection>()" class="form-select"></select>
                <span asp-validation-for="Input.Connection" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Connector" class="form-label">Connector</label>
                <select asp-for="Input.Connector" asp-items="Html.GetEnumSelectList<MobileShop.Models.Enums.CableConnector>()" class="form-select">
                    <option value="">-- None --</option>
                </select>
                <span asp-validation-for="Input.Connector" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.HasMicrophone" class="form-label">Microphone</label>
                <select asp-for="Input.HasMicrophone" class="form-select">
                    <option value="">Unknown</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
                <span asp-validation-for="Input.HasMicrophone" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.ColorId" class="form-label">Color</label>
                <select asp-for="Input.ColorId" asp-items="@(new SelectList(Model.Colors, "Id", "Name"))" class="form-select">
                    <option value="">-- No color --</option>
                </select>
                <span asp-validation-for="Input.ColorId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input asp-for="Input.NoiseCancelling" class="form-check-input" />
                    <label asp-for="Input.NoiseCancelling" class="form-check-label">Noise cancelling</label>
                </div>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.Count" class="form-label">Count</label>
                <input asp-for="Input.Count" class="form-control" min="1" />
                <span asp-validation-for="Input.Count" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-section col-12">
        <h2 class="form-section__title">Guarantee</h2>
        <div class="row g-3">
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Input.HasGuarantee" class="form-check-input" data-guarantee-toggle />
                    <label asp-for="Input.HasGuarantee" class="form-check-label">Has guarantee</label>
                </div>
            </div>
            <div class="col-12" data-guarantee-block style="display:none">
                <label asp-for="Input.GuaranteeCorporation">Guarantee corporation</label>
                <select asp-for="Input.GuaranteeCorporation" asp-items="@(new SelectList(Model.Corporations))" class="form-select">
                    <option value="">Shop Warranty</option>
                </select>
                <label asp-for="Input.GuaranteeExpiry">Guarantee expiry</label>
                <input asp-for="Input.GuaranteeExpiry" class="form-control" type="text" data-jalali-date placeholder="1405/12/29" value="@(Model.Input.GuaranteeExpiry.HasValue ? Model.Input.GuaranteeExpiry.Value.ToJalaliDateString() : string.Empty)" />
                <span asp-validation-for="Input.GuaranteeExpiry" class="text-danger"></span>
                <label asp-for="Input.GuaranteeNotes">Guarantee notes</label>
                <input asp-for="Input.GuaranteeNotes" class="form-control" />
            </div>
        </div>
    </div>
</form>
<div class="action-bar action-bar--static">
    <button class="btn btn-primary" type="submit" form="productCreateForm">Save headphones</button>
    <a asp-page="/Products/Index" class="btn btn-outline-secondary">Cancel</a>
</div>
<partial name="/Pages/Shared/_ProductCreateSuccess.cshtml" model="Model.SuccessMessage" />
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-danger mt-3" role="alert">@Model.Message</div>
}
<div class="modal fade" id="addManufacturerModal" tabindex="-1" aria-labelledby="addManufacturerModal-title" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="addManufacturerModal-title">Add Manufacturer</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><div id="manufacturerModalError" class="alert alert-danger d-none" role="alert"></div><label for="newManufacturerName" class="form-label">Name</label><input type="text" class="form-control" id="newManufacturerName" required /></div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveManufacturerBtn">Save</button></div>
    </div></div>
</div>
<div class="modal fade" id="addModelModal" tabindex="-1" aria-labelledby="addModelModal-title" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="addModelModal-title">Add Model</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><div id="modelModalError" class="alert alert-danger d-none" role="alert"></div><label for="newModelName" class="form-label">Name</label><input type="text" class="form-control" id="newModelName" required /></div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveModelBtn">Save</button></div>
    </div></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-product-pricing.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const manufacturer = document.getElementById('manufacturerSelect');
            const model = document.getElementById('modelSelect');
            const manufacturerError = document.getElementById('manufacturerModalError');
            const modelError = document.getElementById('modelModalError');
            const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const guaranteeToggle = document.querySelector('[data-guarantee-toggle]');
            const guaranteeBlock = document.querySelector('[data-guarantee-block]');

            const syncBlock = (toggle, block) => {
                if (toggle && block) block.style.display = toggle.checked ? '' : 'none';
            };
            guaranteeToggle?.addEventListener('change', () => syncBlock(guaranteeToggle, guaranteeBlock));
            syncBlock(guaranteeToggle, guaranteeBlock);

            const postHandler = async (handler, values) => {
                if (!antiforgeryToken) {
                    throw new Error('The security token is missing. Refresh the page and try again.');
                }
                const response = await fetch(`/Products/CreateHeadphone?handler=${handler}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        RequestVerificationToken: antiforgeryToken
                    },
                    body: new URLSearchParams({ ...values, __RequestVerificationToken: antiforgeryToken })
                });
                const contentType = response.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    throw new Error(`The server returned an unexpected response (HTTP ${response.status}). Refresh the page and try again.`);
                }
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'The request could not be completed.');
                return result;
            };

            const loadModels = async () => {
                model.replaceChildren(new Option('-- Select model --', ''));
                if (!manufacturer.value) return;
                const response = await fetch(`/Products/CreateHeadphone?handler=Models&manufacturerId=${encodeURIComponent(manufacturer.value)}`);
                if (!response.ok) throw new Error('Could not load models for this manufacturer.');
                const models = await response.json();
                models.forEach(item => model.appendChild(new Option(item.name, item.id)));
            };

            manufacturer.addEventListener('change', async () => {
                try {
                    await loadModels();
                    modelError.classList.add('d-none');
                } catch (error) {
                    modelError.textContent = error.message;
                    modelError.classList.remove('d-none');
                }
            });

            document.getElementById('saveManufacturerBtn').addEventListener('click', async () => {
                const nameInput = document.getElementById('newManufacturerName');
                const name = nameInput.value.trim();
                manufacturerError.classList.add('d-none');
                if (!name) {
                    manufacturerError.textContent = 'Enter a manufacturer name.';
                    manufacturerError.classList.remove('d-none');
                    return;
                }
                try {
                    const result = await postHandler('CreateManufacturer', { name });
                    manufacturer.appendChild(new Option(result.name, result.id, true, true));
                    manufacturer.value = result.id;
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('addManufacturerModal')).hide();
                    nameInput.value = '';
                    await loadModels();
                } catch (error) {
                    manufacturerError.textContent = error.message;
                    manufacturerError.classList.remove('d-none');
                }
            });

            document.getElementById('saveModelBtn').addEventListener('click', async () => {
                const nameInput = document.getElementById('newModelName');
                const name = nameInput.value.trim();
                modelError.classList.add('d-none');
                if (!manufacturer.value || !name) {
                    modelError.textContent = !manufacturer.value ? 'Select a manufacturer first.' : 'Enter a model name.';
                    modelError.classList.remove('d-none');
                    return;
                }
                try {
                    const result = await postHandler('CreateModel', { manufacturerId: manufacturer.value, name });
                    model.appendChild(new Option(result.name, result.id, true, true));
                    model.value = result.id;
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('addModelModal')).hide();
                    nameInput.value = '';
                } catch (error) {
                    modelError.textContent = error.message;
                    modelError.classList.remove('d-none');
                }
            });
        });
    </script>
}
