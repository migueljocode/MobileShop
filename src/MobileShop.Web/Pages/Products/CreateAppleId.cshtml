@page
@model MobileShop.Web.Pages.Products.CreateAppleIdModel
@{
    ViewData["Title"] = "Create Apple ID";
}

<h1>Create Apple ID</h1>

<form method="post" class="row g-3 col-lg-7">
    <partial name="/Pages/Shared/_ProductSellerPicker.cshtml" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Input.Price" class="form-label">Paid price (IRR)</label>
        <input asp-for="Input.Price" class="form-control" data-price inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" />
        <span asp-validation-for="Input.Price" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.ProfitPercent" class="form-label">Profit %</label>
        <div class="input-group">
            <input asp-for="Input.ProfitPercent" class="form-control" data-percent />
            <span class="input-group-text">%</span>
        </div>
        <span asp-validation-for="Input.ProfitPercent" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.ProfitAmount" class="form-label">Profit amount (IRR)</label>
        <div class="input-group">
            <span class="input-group-text">IRR</span>
            <input asp-for="Input.ProfitAmount" class="form-control" data-amount inputmode="numeric" step="1" min="0" max="@MobileShop.Models.Settings.MoneyLimits.MaxRials" />
        </div>
        <span asp-validation-for="Input.ProfitAmount" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label class="form-label">Finished price (IRR)</label>
        <input type="text" class="form-control" data-finished-price readonly aria-readonly="true"
               tabindex="-1" />
        <span class="form-text text-muted">Server-stored price (paid + profit).</span>
    </div>

    <div class="col-md-8">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Input.Notes" class="form-label"></label>
        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Input.Notes" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button class="btn btn-primary" type="submit">Save Apple ID</button>
        <a asp-page="/Products/Index" class="btn btn-outline-secondary ms-2">Back to products</a>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-danger mt-3">@Model.Message</div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-product-pricing.js"></script>
}
