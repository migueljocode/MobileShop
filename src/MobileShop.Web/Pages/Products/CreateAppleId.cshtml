@page
@model MobileShop.Web.Pages.Products.CreateAppleIdModel
@{
    ViewData["Title"] = "Create Apple ID";
}

<h1>Create Apple ID</h1>

<form method="post" class="row g-3 col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-4">
        <label asp-for="Input.Price" class="form-label"></label>
        <input asp-for="Input.Price" class="form-control" data-price />
        <span asp-validation-for="Input.Price" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.ProfitPercent" class="form-label">Profit %</label>
        <div class="input-group">
            <input asp-for="Input.ProfitPercent" class="form-control" data-percent />
            <span class="input-group-text">%</span>
        </div>
        <span asp-validation-for="Input.ProfitPercent" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.ProfitAmount" class="form-label">Profit $</label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Input.ProfitAmount" class="form-control" data-amount />
        </div>
        <span asp-validation-for="Input.ProfitAmount" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Input.Notes" class="form-label"></label>
        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Input.Notes" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button class="btn btn-primary" type="submit">Save Apple ID</button>
        <a asp-page="/Products/Index" class="btn btn-outline-secondary ms-2">Back to products</a>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-danger mt-3">@Model.Message</div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const priceEl = document.querySelector('[data-price]');
            const percentEl = document.querySelector('[data-percent]');
            const amountEl = document.querySelector('[data-amount]');

            function updateFromPercent() {
                const price = parseFloat(priceEl.value);
                const percent = parseFloat(percentEl.value);
                if (isNaN(price) || price === 0 || isNaN(percent)) {
                    amountEl.value = '';
                    return;
                }
                amountEl.value = (price * percent / 100).toFixed(2);
            }

            function updateFromAmount() {
                const price = parseFloat(priceEl.value);
                const amount = parseFloat(amountEl.value);
                if (isNaN(price) || price === 0 || isNaN(amount)) {
                    percentEl.value = '';
                    return;
                }
                percentEl.value = (amount / price * 100).toFixed(2);
            }

            percentEl.addEventListener('input', updateFromPercent);
            amountEl.addEventListener('input', updateFromAmount);
        });
    </script>
}
