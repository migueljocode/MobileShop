@page
@model MobileShop.Web.Pages.Reports.ProfitLossModel
@{
    ViewData["Title"] = "Profit and loss";
    var chartFrom = Model.EffectiveFrom;
    var chartTo = Model.EffectiveTo;
    if (Model.Mode == DateRangeMode.Automatic)
    {
        switch (Model.Preset)
        {
            case AutomaticPreset.Today:
                chartFrom = Model.EffectiveTo.Date;
                chartTo = chartFrom.AddDays(1).AddTicks(-1);
                break;
            case AutomaticPreset.Week:
                chartFrom = Model.EffectiveFrom.Date;
                chartTo = chartFrom.AddDays(7).AddTicks(-1);
                break;
            case AutomaticPreset.Month:
                chartFrom = new DateTime(Model.EffectiveFrom.Year, Model.EffectiveFrom.Month, 1);
                chartTo = chartFrom.AddMonths(1).AddTicks(-1);
                break;
            case AutomaticPreset.Year:
                chartFrom = new DateTime(Model.EffectiveFrom.Year, 1, 1);
                chartTo = chartFrom.AddYears(1).AddTicks(-1);
                break;
            case AutomaticPreset.All:
                chartFrom = new DateTime(Model.EffectiveFrom.Year, 1, 1);
                chartTo = new DateTime(Model.EffectiveTo.Year, 12, 31, 23, 59, 59);
                break;
        }
    }
    // Use Jalali period calculations to match the service layer
    var trendValues = Model.TrendPoints.ToDictionary(row => row.PeriodStart, row => row.Profit);
    var firstPeriod = chartFrom.ToJalaliPeriodStart(Model.TrendInterval);
    var chartEnd = chartTo;
    var lastPeriod = chartEnd.ToJalaliPeriodStart(Model.TrendInterval);
    if (lastPeriod < firstPeriod) lastPeriod = firstPeriod;
    var trendPoints = new List<(DateTime Period, long Profit)>();
    for (var period = firstPeriod; period <= lastPeriod; period = period.NextJalaliPeriod(Model.TrendInterval))
    {
        trendPoints.Add((period, trendValues.GetValueOrDefault(period)));
    }
    var showMonthlyWeeks = Model.Mode == DateRangeMode.Automatic && Model.Preset == AutomaticPreset.Month;
    var chartPoints = showMonthlyWeeks
        ? Enumerable.Range(0, 4)
            .Select(week => (
                Label: $"Week {week + 1}",
                Profit: trendPoints
                    .Where(point => point.Period.Month == chartFrom.Month && point.Period.Year == chartFrom.Year
                        && (point.Period.Day - 1) / 7 == week)
                    .Sum(point => point.Profit)))
            .ToList()
        : trendPoints.Select(point => (Label: FormatPeriod(point.Period), point.Profit)).ToList();
    var chartIntervalLabel = showMonthlyWeeks ? "Week" : Model.TrendInterval switch
    {
        ProfitLossInterval.Hour => "Hour of day",
        ProfitLossInterval.Day => "Day",
        ProfitLossInterval.Month => "Month",
        ProfitLossInterval.Year => "Year",
        _ => "Week"
    };
    var currentIndex = showMonthlyWeeks
        ? (DateTime.Now.Day - 1) / 7
        : trendPoints.FindIndex(point => point.Period == DateTime.Now.ToJalaliPeriodStart(Model.TrendInterval));
    var chartLabels = System.Text.Json.JsonSerializer.Serialize(chartPoints.Select(point => point.Label));
    var chartTickLabels = chartLabels;
    var chartValues = System.Text.Json.JsonSerializer.Serialize(chartPoints.Select(point => point.Profit));
    var chartLabelsJson = chartLabels;
    var chartValuesJson = chartValues;
    var chartHeading = showMonthlyWeeks ? "Weekly profit & loss" : Model.TrendInterval switch
    {
        ProfitLossInterval.Month => "Monthly profit & loss",
        ProfitLossInterval.Week => "Weekly profit & loss",
        ProfitLossInterval.Day => "Daily profit & loss",
        ProfitLossInterval.Hour => "Hourly profit & loss",
        ProfitLossInterval.Year => "Yearly profit & loss",
        _ => "Profit & loss"
    };
    string FormatPeriod(DateTime period) => Model.TrendInterval switch
    {
        ProfitLossInterval.Year => period.ToJalaliYearString(),
        ProfitLossInterval.Month => period.ToJalaliYearMonthString(),
        ProfitLossInterval.Week => $"Week of {period.ToJalaliDateString()}",
        ProfitLossInterval.Day => period.ToJalaliDateString(),
        ProfitLossInterval.Hour => $"{period.ToJalaliDateString()} {period:HH:mm}",
        _ => period.ToJalaliDateString()
    };
}
<h1>Profit and loss</h1>
<form method="get" class="row g-2 mb-3" id="profitLossFilters">
    <fieldset class="col-12">
        <legend class="form-label mb-1">Date range mode:</legend>
        <div class="btn-group" role="group" aria-label="Date range mode">
            <input type="radio" class="btn-check" name="Mode" id="mode-auto" value="Automatic"
                   @(Model.Mode == DateRangeMode.Automatic ? "checked" : "") autocomplete="off" />
            <label class="btn btn-outline-primary" for="mode-auto">Automatic</label>

            <input type="radio" class="btn-check" name="Mode" id="mode-manual" value="Manual"
                   @(Model.Mode == DateRangeMode.Manual ? "checked" : "") autocomplete="off" />
            <label class="btn btn-outline-primary" for="mode-manual">Manual</label>
        </div>
    </fieldset>

    <div id="auto-controls" class="@(Model.Mode == DateRangeMode.Automatic ? "" : "d-none") col-12">
        <label class="form-label mb-1" asp-for="Preset">Preset:</label>
        <select asp-for="Preset" class="form-select" style="max-width: 150px;">
            <option value="Today">Today</option>
            <option value="Week">Week</option>
            <option value="Month">Month</option>
            <option value="Year">Year</option>
            <option value="All">All</option>
        </select>
    </div>

    <div id="manual-controls" class="@(Model.Mode == DateRangeMode.Manual ? "" : "d-none") row g-2">
        <div class="col-md-3"><label class="form-label" asp-for="From">From</label><input type="text" id="From" name="From" class="form-control" data-jalali-date placeholder="1405/01/01" value="@(Model.From?.ToJalaliDateString())" /></div>
        <div class="col-md-3"><label class="form-label" asp-for="To">To</label><input type="text" id="To" name="To" class="form-control" data-jalali-date placeholder="1405/12/29" value="@(Model.To?.ToJalaliDateString())" /></div>
    </div>

    @if (Model.EmptyDatabaseNote is not null)
    {
        <div class="col-12">
            <p class="text-info mb-0">@Model.EmptyDatabaseNote</p>
        </div>
    }
</form>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const autoRadio = document.getElementById('mode-auto');
        const manualRadio = document.getElementById('mode-manual');
        const autoControls = document.getElementById('auto-controls');
        const manualControls = document.getElementById('manual-controls');
        const filterForm = document.getElementById('profitLossFilters');

        function updateVisibility() {
            if (autoRadio.checked) {
                autoControls.classList.remove('d-none');
                manualControls.classList.add('d-none');
            } else if (manualRadio.checked) {
                autoControls.classList.add('d-none');
                manualControls.classList.remove('d-none');
            }
        }

        function submitFilters() {
            filterForm.requestSubmit();
        }

        autoRadio.addEventListener('change', () => {
            updateVisibility();
            submitFilters();
        });
        manualRadio.addEventListener('change', () => {
            updateVisibility();
            submitFilters();
        });
        document.getElementById('Preset').addEventListener('change', submitFilters);
        document.getElementById('From').addEventListener('change', submitFilters);
        document.getElementById('To').addEventListener('change', submitFilters);
        updateVisibility();
    });
</script>

<ul class="nav nav-tabs mb-3" id="profitLossTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="profit-tab" data-bs-toggle="tab" data-bs-target="#profit" type="button" role="tab">Profit &amp; Loss</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="distribution-tab" data-bs-toggle="tab" data-bs-target="#distribution" type="button" role="tab">Distribution</button>
    </li>
</ul>

<div class="tab-content" id="profitLossTabsContent">
    <div class="tab-pane fade show active" id="profit" role="tabpanel">
        <p class="lead">Total profit (Toman): <strong><span class="@(Model.TotalProfit >= 0 ? "text-success" : "text-danger")">@(Model.TotalProfit > 0 ? "+" : "")@Model.TotalProfit.ToToman()</span></strong></p>
        <section class="profit-chart-card" aria-labelledby="profit-chart-title">
            <div class="profit-chart-heading">
                <div>
                    <h2 id="profit-chart-title">@chartHeading</h2>
                    <p>Net result by @(showMonthlyWeeks ? "week" : Model.TrendInterval.ToString().ToLowerInvariant()) across the selected date range</p>
                </div>
                <span class="profit-chart-range">@Model.EffectiveFrom.ToJalaliDateString() – @Model.EffectiveTo.ToJalaliDateString()</span>
            </div>
            <div class="profit-chart-canvas">
                <canvas id="profitLossChart"
                        data-labels='@Html.Raw(chartLabelsJson)'
                        data-tick-labels='@Html.Raw(chartTickLabels)'
                        data-values='@Html.Raw(chartValuesJson)'
                        data-current-index="@currentIndex"
                        data-interval-label="@chartIntervalLabel"
                        aria-label="Profit and loss by @Model.TrendInterval.ToString().ToLowerInvariant()"></canvas>
            </div>
                <div class="profit-chart-legend"><span aria-hidden="true"></span> Net profit / loss</div>
        </section>
        <table class="table table-striped"><thead><tr><th>Product</th><th>Bought (Toman)</th><th>Sold (Toman)</th><th>Profit / loss (Toman)</th><th>By percent</th></tr></thead><tbody>
@foreach (var row in Model.Rows)
{
    var profitClass = row.Profit >= 0 ? "text-success" : "text-danger";
    <tr><td>@row.ProductLabel</td><td>@row.Bought.ToToman()</td><td>@row.Sold.ToToman()</td><td class="@profitClass">@row.Profit.ToToman()</td><td class="@profitClass">@row.ProfitPercent.ToString("F2")%</td></tr>
}
</tbody></table>
    </div>

    <div class="tab-pane fade" id="distribution" role="tabpanel">
        <p class="lead">Total profit (Toman): <strong><span class="@(Model.TotalProfit >= 0 ? "text-success" : "text-danger")">@(Model.TotalProfit > 0 ? "+" : "")@Model.TotalProfit.ToToman()</span></strong></p>
        <table class="table table-striped"><thead><tr><th>Employee</th><th>Share %</th><th>Amount (Toman)</th></tr></thead><tbody>
@foreach (var row in Model.DistributionRows)
{
    <tr class="@(row.IsLossPeriod ? "table-danger" : "")">
        <td>@row.EmployeeName</td>
        <td>@row.SharePercent%</td>
        <td>@row.CalculatedAmount.ToToman()</td>
    </tr>
}
</tbody></table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/profit-loss-chart.js" asp-append-version="true"></script>
}
