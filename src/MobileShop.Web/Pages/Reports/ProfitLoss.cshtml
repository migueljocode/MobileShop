@page
@model MobileShop.Web.Pages.Reports.ProfitLossModel
@{
    ViewData["Title"] = "Profit and loss";
    var chartFrom = Model.EffectiveFrom;
    var chartTo = Model.EffectiveTo;
    if (Model.Mode == DateRangeMode.Automatic)
    {
        switch (Model.Preset)
        {
            case AutomaticPreset.Today:
                chartFrom = Model.EffectiveTo.Date;
                chartTo = chartFrom.AddDays(1).AddTicks(-1);
                break;
            case AutomaticPreset.Week:
                chartFrom = Model.EffectiveFrom.Date;
                chartTo = chartFrom.AddDays(7).AddTicks(-1);
                break;
            case AutomaticPreset.Month:
                chartFrom = new DateTime(Model.EffectiveFrom.Year, Model.EffectiveFrom.Month, 1);
                chartTo = chartFrom.AddMonths(1).AddTicks(-1);
                break;
            case AutomaticPreset.Year:
                chartFrom = new DateTime(Model.EffectiveFrom.Year, 1, 1);
                chartTo = chartFrom.AddYears(1).AddTicks(-1);
                break;
            case AutomaticPreset.All:
                chartFrom = new DateTime(Model.EffectiveFrom.Year, 1, 1);
                chartTo = new DateTime(Model.EffectiveTo.Year, 12, 31, 23, 59, 59);
                break;
        }
    }
    // Use Jalali period calculations to match the service layer
    var trendValues = Model.TrendPoints.ToDictionary(row => row.PeriodStart, row => row.Profit);
    var firstPeriod = chartFrom.ToJalaliPeriodStart(Model.TrendInterval);
    var chartEnd = chartTo;
    var lastPeriod = chartEnd.ToJalaliPeriodStart(Model.TrendInterval);
    if (lastPeriod < firstPeriod) lastPeriod = firstPeriod;
    var trendPoints = new List<(DateTime Period, long Profit)>();
    for (var period = firstPeriod; period <= lastPeriod; period = period.NextJalaliPeriod(Model.TrendInterval))
    {
        trendPoints.Add((period, trendValues.GetValueOrDefault(period)));
    }
    var showMonthlyWeeks = Model.Mode == DateRangeMode.Automatic && Model.Preset == AutomaticPreset.Month;
    var chartPoints = showMonthlyWeeks
        ? Enumerable.Range(0, 4)
            .Select(week => (
                Label: $"Week {week + 1}",
                Profit: trendPoints
                    .Where(point => point.Period.Month == chartFrom.Month && point.Period.Year == chartFrom.Year
                        && (point.Period.Day - 1) / 7 == week)
                    .Sum(point => point.Profit)))
            .ToList()
        : trendPoints.Select(point => (Label: FormatPeriod(point.Period), point.Profit)).ToList();
    var chartIntervalLabel = showMonthlyWeeks ? "Week" : Model.TrendInterval switch
    {
        ProfitLossInterval.Hour => "Hour of day",
        ProfitLossInterval.Day => "Day",
        ProfitLossInterval.Month => "Month",
        ProfitLossInterval.Year => "Year",
        _ => "Week"
    };
    var currentIndex = showMonthlyWeeks
        ? (DateTime.Now.Day - 1) / 7
        : trendPoints.FindIndex(point => point.Period == DateTime.Now.ToJalaliPeriodStart(Model.TrendInterval));
    var chartLabels = System.Text.Json.JsonSerializer.Serialize(chartPoints.Select(point => point.Label));
    var chartTickLabels = chartLabels;
    var chartValues = System.Text.Json.JsonSerializer.Serialize(chartPoints.Select(point => point.Profit));
    var chartLabelsJson = chartLabels;
    var chartValuesJson = chartValues;
    var chartHeading = showMonthlyWeeks ? "Weekly profit & loss" : Model.TrendInterval switch
    {
        ProfitLossInterval.Month => "Monthly profit & loss",
        ProfitLossInterval.Week => "Weekly profit & loss",
        ProfitLossInterval.Day => "Daily profit & loss",
        ProfitLossInterval.Hour => "Hourly profit & loss",
        ProfitLossInterval.Year => "Yearly profit & loss",
        _ => "Profit & loss"
    };
    string FormatPeriod(DateTime period) => Model.TrendInterval switch
    {
        ProfitLossInterval.Year => period.ToJalaliYearString(),
        ProfitLossInterval.Month => period.ToJalaliYearMonthString(),
        ProfitLossInterval.Week => $"Week of {period.ToJalaliDateString()}",
        ProfitLossInterval.Day => period.ToJalaliDateString(),
        ProfitLossInterval.Hour => $"{period.ToJalaliDateString()} {period:HH:mm}",
        _ => period.ToJalaliDateString()
    };
}
<div class="page-head"><div><h1 class="page-head__title">Profit and loss</h1><p class="page-head__sub">Income, expenses and net result for the selected period</p></div></div>
<form method="get" class="form-section" id="profitLossFilters">
    <div class="row g-3 align-items-end">
        <fieldset class="col-12 col-lg-auto">
            <legend class="form-label mb-2">Date range mode</legend>
            <div class="segmented" role="group" aria-label="Date range mode">
                <input type="radio" class="btn-check" name="Mode" id="mode-auto" value="Automatic"
                       @(Model.Mode == DateRangeMode.Automatic ? "checked" : "") autocomplete="off" />
                <label class="btn" for="mode-auto">Automatic</label>

                <input type="radio" class="btn-check" name="Mode" id="mode-manual" value="Manual"
                       @(Model.Mode == DateRangeMode.Manual ? "checked" : "") autocomplete="off" />
                <label class="btn" for="mode-manual">Manual</label>
            </div>
        </fieldset>

        <div id="auto-controls" class="@(Model.Mode == DateRangeMode.Automatic ? "" : "d-none") col-12 col-md-6 col-lg-4">
            <label class="form-label mb-2" asp-for="Preset">Preset</label>
            <select asp-for="Preset" class="form-select">
                <option value="Today">Today</option>
                <option value="Week">Week</option>
                <option value="Month">Month</option>
                <option value="Year">Year</option>
                <option value="All">All</option>
            </select>
        </div>

        <div id="manual-controls" class="@(Model.Mode == DateRangeMode.Manual ? "" : "d-none") col-12 col-md-6 col-lg-5">
            <div class="row g-3">
                <div class="col-6"><label class="form-label mb-2" asp-for="From">From</label><input type="text" id="From" name="From" class="form-control" data-jalali-date placeholder="1405/01/01" value="@(Model.From?.ToJalaliDateString())" /></div>
                <div class="col-6"><label class="form-label mb-2" asp-for="To">To</label><input type="text" id="To" name="To" class="form-control" data-jalali-date placeholder="1405/12/29" value="@(Model.To?.ToJalaliDateString())" /></div>
            </div>
        </div>

        @if (Model.EmptyDatabaseNote is not null)
        {
            <div class="col-12">
                <partial name="_EmptyState" model="(Model.EmptyDatabaseNote!, (string?)null)" />
            </div>
        }
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const autoRadio = document.getElementById('mode-auto');
        const manualRadio = document.getElementById('mode-manual');
        const autoControls = document.getElementById('auto-controls');
        const manualControls = document.getElementById('manual-controls');
        const filterForm = document.getElementById('profitLossFilters');

        function updateVisibility() {
            if (autoRadio.checked) {
                autoControls.classList.remove('d-none');
                manualControls.classList.add('d-none');
            } else if (manualRadio.checked) {
                autoControls.classList.add('d-none');
                manualControls.classList.remove('d-none');
            }
        }

        function submitFilters() {
            filterForm.requestSubmit();
        }

        autoRadio.addEventListener('change', () => {
            updateVisibility();
            submitFilters();
        });
        manualRadio.addEventListener('change', () => {
            updateVisibility();
            submitFilters();
        });
        document.getElementById('Preset').addEventListener('change', submitFilters);
        document.getElementById('From').addEventListener('change', submitFilters);
        document.getElementById('To').addEventListener('change', submitFilters);
        updateVisibility();
    });
</script>

<ul class="nav nav-tabs mb-3" id="profitLossTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="profit-tab" data-bs-toggle="tab" data-bs-target="#profit" type="button" role="tab">Profit &amp; Loss</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="distribution-tab" data-bs-toggle="tab" data-bs-target="#distribution" type="button" role="tab">Distribution</button>
    </li>
</ul>

<div class="tab-content" id="profitLossTabsContent">
    <div class="tab-pane fade show active" id="profit" role="tabpanel">
        <div class="stat-grid"><div class="stat"><div class="stat__value num"><span class="@(Model.TotalProfit >= 0 ? "text-success" : "text-danger")">@(Model.TotalProfit > 0 ? "+" : "")@Model.TotalProfit.ToToman()</span></div><div class="stat__label">Total profit (Toman)</div></div></div>
        <section class="profit-chart-card" aria-labelledby="profit-chart-title">
            <div class="profit-chart-heading">
                <div>
                    <h2 id="profit-chart-title">@chartHeading</h2>
                    <p>Net result by @(showMonthlyWeeks ? "week" : Model.TrendInterval.ToString().ToLowerInvariant()) across the selected date range</p>
                </div>
                <span class="profit-chart-range">@Model.EffectiveFrom.ToJalaliDateString() – @Model.EffectiveTo.ToJalaliDateString()</span>
            </div>
            <div class="profit-chart-canvas">
                <canvas id="profitLossChart"
                        data-labels='@Html.Raw(chartLabelsJson)'
                        data-tick-labels='@Html.Raw(chartTickLabels)'
                        data-values='@Html.Raw(chartValuesJson)'
                        data-current-index="@currentIndex"
                        data-interval-label="@chartIntervalLabel"
                        aria-label="Profit and loss by @Model.TrendInterval.ToString().ToLowerInvariant()"
                        aria-describedby="profit-chart-desc"></canvas>
            </div>
            <p id="profit-chart-desc" class="visually-hidden">Line chart of profit and loss over the selected date range. The table below lists profit and loss per product.</p>
                <div class="profit-chart-legend"><span aria-hidden="true"></span> Net profit / loss</div>
        </section>
        <div class="table-responsive">
        <table class="data-table"><thead><tr><th scope="col">Product</th><th scope="col" class="num">Bought (Toman)</th><th scope="col" class="num">Sold (Toman)</th><th scope="col" class="num">Profit / loss (Toman)</th><th scope="col" class="num">By percent</th></tr></thead><tbody>
@foreach (var row in Model.Rows)
{
    var profitClass = row.Profit >= 0 ? "text-success" : "text-danger";
    <tr><td dir="auto">@row.ProductLabel</td><td class="num">@row.Bought.ToToman()</td><td class="num">@row.Sold.ToToman()</td><td class="num @profitClass">@row.Profit.ToToman()</td><td class="num @profitClass">@row.ProfitPercent.ToString("F2")%</td></tr>
}
</tbody></table>
        </div>
    </div>

    <div class="tab-pane fade" id="distribution" role="tabpanel">
        <partial name="_ProductCreateSuccess" model="Model.SuccessMessage" />
        <div class="stat-grid"><div class="stat"><div class="stat__value num"><span class="@(Model.TotalProfit >= 0 ? "text-success" : "text-danger")">@(Model.TotalProfit > 0 ? "+" : "")@Model.TotalProfit.ToToman()</span></div><div class="stat__label">Total profit (Toman)</div></div></div>
        @if (Model.EditableShares.Count > 0)
        {
            <div class="d-flex justify-content-end my-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editSharesModal">Edit shares</button>
            </div>
        }
        else
        {
            <p class="text-muted small my-2">No active employees.</p>
        }
        @if (Model.DistributionError is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.DistributionError</div>
        }
        else
        {
            <div class="table-responsive">
            <table class="data-table"><thead><tr><th scope="col">Employee</th><th scope="col" class="num">Share %</th><th scope="col" class="num">Amount (Toman)</th></tr></thead><tbody>
            @foreach (var row in Model.DistributionRows)
            {
                <tr class="@(row.IsLossPeriod ? "row-danger" : "")">
                    <td dir="auto">@row.EmployeeName</td>
                    <td class="num">@row.SharePercent%</td>
                    <td class="num">@row.CalculatedAmount.ToToman()</td>
                </tr>
            }
            </tbody></table>
            </div>
        }
    </div>
</div>

@{
    var shopPercent = 100 - Model.EditableShares.Sum(share => share.SharePercent);
}
<div class="modal fade" id="editSharesModal" tabindex="-1" aria-labelledby="editSharesModalLabel" aria-hidden="true"
     data-total-profit="@Model.TotalProfit.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-open-on-load="@(Model.SharesError is not null ? "true" : "false")">
    <div class="modal-dialog modal-dialog-scrollable">
        <form method="post" asp-page-handler="SaveShares" id="editSharesForm" class="modal-content" novalidate>
            <input type="hidden" name="Mode" value="@Model.Mode" />
            <input type="hidden" name="Preset" value="@Model.Preset" />
            <input type="hidden" name="From" value="@Model.From?.ToJalaliDateString()" />
            <input type="hidden" name="To" value="@Model.To?.ToJalaliDateString()" />
            <div class="modal-header">
                <h2 class="modal-title h5" id="editSharesModalLabel">Edit profit shares</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Each share is a percent of the total profit. The shop receives whatever is left.</p>
                @if (Model.SharesError is not null)
                {
                    <div class="alert alert-danger" role="alert">@Model.SharesError</div>
                }
                <p class="share-editor__hint small mb-2">Amounts are in Toman.</p>
                <div class="share-editor">
                    @for (var i = 0; i < Model.EditableShares.Count; i++)
                    {
                        var share = Model.EditableShares[i];
                        var inputPercent = Model.PostedPercents.TryGetValue(share.EmployeeId, out var posted) ? posted : share.SharePercent;
                        <div class="share-row" data-share-row data-original-percent="@share.SharePercent">
                            <div class="share-row__head">
                                <div class="share-row__title">
                                    <span class="share-row__name" dir="auto">@share.Name</span>
                                    <span class="share-row__note small" data-change></span>
                                </div>
                                <div class="share-row__input">
                                    <input type="hidden" name="Shares[@i].EmployeeId" value="@share.EmployeeId" />
                                    <input type="number" class="form-control form-control-sm num" name="Shares[@i].SharePercent" value="@inputPercent" min="0" max="100" step="1" inputmode="numeric" required data-share-input aria-label="Share percent for @share.Name" />
                                    <span class="share-row__unit" aria-hidden="true">%</span>
                                </div>
                            </div>
                                <dl class="share-row__amounts">
                                    <div class="share-row__line share-row__line--plain"><dt>Amount</dt><dd data-amount></dd></div>
                                    <div class="share-row__line share-row__line--changed"><dt>Was</dt><dd data-was></dd></div>
                                    <div class="share-row__line share-row__line--changed"><dt>Now</dt><dd data-now></dd></div>
                                    <div class="share-row__line share-row__line--changed"><dt>Change</dt><dd class="share-row__delta" data-delta></dd></div>
                                </dl>
                        </div>
                    }
                    <div class="share-row" data-shop-row data-original-percent="@shopPercent">
                        <div class="share-row__head">
                            <div class="share-row__title">
                                <span class="share-row__name">Shop</span>
                                <span class="share-row__note small" data-change></span>
                            </div>
                            <span class="share-row__percent num" data-shop-share>@shopPercent%</span>
                        </div>
                            <dl class="share-row__amounts">
                                <div class="share-row__line share-row__line--plain"><dt>Amount</dt><dd data-amount></dd></div>
                                <div class="share-row__line share-row__line--changed"><dt>Was</dt><dd data-was></dd></div>
                                <div class="share-row__line share-row__line--changed"><dt>Now</dt><dd data-now></dd></div>
                                <div class="share-row__line share-row__line--changed"><dt>Change</dt><dd class="share-row__delta" data-delta></dd></div>
                            </dl>
                    </div>
                </div>
                <p class="small mb-1" role="status" aria-live="polite" data-summary></p>
                @if (Model.TotalProfit <= 0)
                {
                    <p class="small text-muted mb-0" data-no-profit>No profit in this range — amounts are 0, percentages still apply.</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary share-editor__save" data-save>Save changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/profit-loss-chart.js" asp-append-version="true"></script>
    <script src="~/js/distribution-shares.js" asp-append-version="true"></script>
}
