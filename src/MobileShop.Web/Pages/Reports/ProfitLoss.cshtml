@page
@model MobileShop.Web.Pages.Reports.ProfitLossModel
@{ ViewData["Title"] = "Profit and loss"; }
<h1>Profit and loss</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><label class="form-label">From</label><input class="form-control" type="date" asp-for="From" /></div>
    <div class="col-md-3"><label class="form-label">To</label><input class="form-control" type="date" asp-for="To" /></div>
    <div class="col-md-2 align-self-end"><button class="btn btn-primary">Apply</button></div>
</form>
<p class="lead">Total profit: <strong>@Model.TotalProfit.ToString("N0")</strong></p>
<table class="table table-striped"><thead><tr><th>Product</th><th>Bought</th><th>Sold</th><th>Profit / loss</th></tr></thead><tbody>
@foreach (var row in Model.Rows)
{ <tr><td>@row.ProductLabel</td><td>@row.Bought.ToString("N0")</td><td>@row.Sold.ToString("N0")</td><td>@row.Profit.ToString("N0")</td></tr> }
</tbody></table>
