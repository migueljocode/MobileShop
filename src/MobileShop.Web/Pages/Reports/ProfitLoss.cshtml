@page
@using MobileShop.Models.Extensions
@using System.Globalization
@model MobileShop.Web.Pages.Reports.ProfitLossModel
@{
    ViewData["Title"] = "Profit and loss";
    const decimal chartWidth = 960m;
    const decimal chartHeight = 320m;
    const decimal chartLeft = 84m;
    const decimal chartRight = 24m;
    const decimal chartTop = 24m;
    const decimal chartBottom = 48m;
    var plotWidth = chartWidth - chartLeft - chartRight;
    var plotHeight = chartHeight - chartTop - chartBottom;
    DateTime GetPeriodStart(DateTime date, ProfitLossInterval interval) => interval switch
    {
        ProfitLossInterval.Month => new DateTime(date.Year, date.Month, 1),
        ProfitLossInterval.Week => date.Date.AddDays(-(((int)date.DayOfWeek + 6) % 7)),
        ProfitLossInterval.Day => date.Date,
        ProfitLossInterval.Hour => new DateTime(date.Year, date.Month, date.Day, date.Hour, 0, 0),
        _ => date.Date
    };
    DateTime AddPeriod(DateTime period, ProfitLossInterval interval) => interval switch
    {
        ProfitLossInterval.Month => period.AddMonths(1),
        ProfitLossInterval.Week => period.AddDays(7),
        ProfitLossInterval.Day => period.AddDays(1),
        ProfitLossInterval.Hour => period.AddHours(1),
        _ => period.AddDays(1)
    };
    var trendValues = Model.TrendPoints.ToDictionary(row => row.PeriodStart, row => row.Profit);
    var firstPeriod = GetPeriodStart(Model.EffectiveFrom, Model.TrendInterval);
    var chartEnd = Model.TrendInterval == ProfitLossInterval.Hour
        ? Model.EffectiveTo.Date.AddDays(1).AddTicks(-1)
        : Model.EffectiveTo;
    var lastPeriod = GetPeriodStart(chartEnd, Model.TrendInterval);
    if (lastPeriod < firstPeriod) lastPeriod = firstPeriod;
    var trendPoints = new List<(DateTime Period, long Profit)>();
    for (var period = firstPeriod; period <= lastPeriod; period = AddPeriod(period, Model.TrendInterval))
    {
        trendPoints.Add((period, trendValues.GetValueOrDefault(period)));
    }
    var trendPointsCount = trendPoints.Count;
    var chartPoints = trendPoints.Select((point, index) => new
    {
        point.Period,
        point.Profit,
        X = trendPointsCount == 1
            ? chartLeft + plotWidth / 2m
            : chartLeft + index * plotWidth / (trendPointsCount - 1),
        Y = 0m
    }).ToList();
    var minimumProfit = Math.Min(0m, trendPoints.Count == 0 ? 0m : trendPoints.Min(point => (decimal)point.Profit));
    var maximumProfit = Math.Max(0m, trendPoints.Count == 0 ? 0m : trendPoints.Max(point => (decimal)point.Profit));
    if (maximumProfit == minimumProfit)
    {
        minimumProfit = -1m;
        maximumProfit = 1m;
    }
    var profitRange = maximumProfit - minimumProfit;
    var points = chartPoints.Select(point => new
    {
        point.Period,
        point.Profit,
        point.X,
        Y = chartTop + (maximumProfit - point.Profit) / profitRange * plotHeight
    }).ToList();
    var coordinateFormat = CultureInfo.InvariantCulture;
    var linePoints = string.Join(" ", points.Select(point =>
        $"{point.X.ToString("0.##", coordinateFormat)},{point.Y.ToString("0.##", coordinateFormat)}"));
    var zeroLineY = chartTop + maximumProfit / profitRange * plotHeight;
    var chartLabelStep = Math.Max(1, (int)Math.Ceiling(points.Count / 6m));
    var chartHeading = Model.TrendInterval switch
    {
        ProfitLossInterval.Month => "Monthly profit & loss",
        ProfitLossInterval.Week => "Weekly profit & loss",
        ProfitLossInterval.Day => "Daily profit & loss",
        ProfitLossInterval.Hour => "Hourly profit & loss",
        _ => "Profit & loss"
    };
    string FormatPeriod(DateTime period) => Model.TrendInterval switch
    {
        ProfitLossInterval.Month => period.ToString("MMM yy"),
        ProfitLossInterval.Week => $"Week of {period:M/d}",
        ProfitLossInterval.Day => period.ToString("MMM d"),
        ProfitLossInterval.Hour => period.ToString("h tt"),
        _ => period.ToString("MMM d")
    };
}
<h1>Profit and loss</h1>
<form method="get" class="row g-2 mb-3" id="profitLossFilters">
    <fieldset class="col-12">
        <legend class="form-label mb-1">Date range mode:</legend>
        <div class="btn-group" role="group" aria-label="Date range mode">
            <input type="radio" class="btn-check" name="Mode" id="mode-auto" value="Automatic"
                   @(Model.Mode == DateRangeMode.Automatic ? "checked" : "") autocomplete="off" />
            <label class="btn btn-outline-primary" for="mode-auto">Automatic</label>

            <input type="radio" class="btn-check" name="Mode" id="mode-manual" value="Manual"
                   @(Model.Mode == DateRangeMode.Manual ? "checked" : "") autocomplete="off" />
            <label class="btn btn-outline-primary" for="mode-manual">Manual</label>
        </div>
    </fieldset>

    <div id="auto-controls" class="@(Model.Mode == DateRangeMode.Automatic ? "" : "d-none") col-12">
        <label class="form-label mb-1" asp-for="Preset">Preset:</label>
        <select asp-for="Preset" class="form-select" style="max-width: 150px;">
            <option value="Today">Today</option>
            <option value="Week">Week</option>
            <option value="Month">Month</option>
            <option value="Year">Year</option>
            <option value="All">All</option>
        </select>
    </div>

    <div id="manual-controls" class="@(Model.Mode == DateRangeMode.Manual ? "" : "d-none") row g-2">
        <div class="col-md-3"><label class="form-label" asp-for="From">From</label><input type="date" id="From" name="From" class="form-control" value="@(Model.From?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" /></div>
        <div class="col-md-3"><label class="form-label" asp-for="To">To</label><input type="date" id="To" name="To" class="form-control" value="@(Model.To?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" /></div>
    </div>

    @if (Model.EmptyDatabaseNote is not null)
    {
        <div class="col-12">
            <p class="text-info mb-0">@Model.EmptyDatabaseNote</p>
        </div>
    }
</form>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const autoRadio = document.getElementById('mode-auto');
        const manualRadio = document.getElementById('mode-manual');
        const autoControls = document.getElementById('auto-controls');
        const manualControls = document.getElementById('manual-controls');
        const filterForm = document.getElementById('profitLossFilters');

        function updateVisibility() {
            if (autoRadio.checked) {
                autoControls.classList.remove('d-none');
                manualControls.classList.add('d-none');
            } else if (manualRadio.checked) {
                autoControls.classList.add('d-none');
                manualControls.classList.remove('d-none');
            }
        }

        function submitFilters() {
            filterForm.requestSubmit();
        }

        autoRadio.addEventListener('change', () => {
            updateVisibility();
            submitFilters();
        });
        manualRadio.addEventListener('change', () => {
            updateVisibility();
            submitFilters();
        });
        document.getElementById('Preset').addEventListener('change', submitFilters);
        document.getElementById('From').addEventListener('change', submitFilters);
        document.getElementById('To').addEventListener('change', submitFilters);
        updateVisibility();
    });
</script>

<ul class="nav nav-tabs mb-3" id="profitLossTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="profit-tab" data-bs-toggle="tab" data-bs-target="#profit" type="button" role="tab">Profit &amp; Loss</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="distribution-tab" data-bs-toggle="tab" data-bs-target="#distribution" type="button" role="tab">Distribution</button>
    </li>
</ul>

<div class="tab-content" id="profitLossTabsContent">
    <div class="tab-pane fade show active" id="profit" role="tabpanel">
        <p class="lead">Total profit (IRR): <strong><span class="@(Model.TotalProfit >= 0 ? "text-success" : "text-danger")">@(Model.TotalProfit > 0 ? "+" : "")@Model.TotalProfit.ToIrr()</span></strong></p>
        <section class="profit-chart-card" aria-labelledby="profit-chart-title">
            <div class="profit-chart-heading">
                <div>
                    <h2 id="profit-chart-title">@chartHeading</h2>
                    <p>Net result by @Model.TrendInterval.ToString().ToLowerInvariant() across the selected date range</p>
                </div>
                <span class="profit-chart-range">@Model.EffectiveFrom.ToString("MMM d, yyyy") – @Model.EffectiveTo.ToString("MMM d, yyyy")</span>
            </div>
            <div class="profit-chart-scroll">
                    <svg class="profit-chart" viewBox="0 0 960 320" role="img" aria-labelledby="profit-chart-title profit-chart-description" preserveAspectRatio="xMidYMid meet">
                        <desc id="profit-chart-description">A @Model.TrendInterval.ToString().ToLowerInvariant() line chart showing net profit or loss in IRR. Empty intervals are shown at zero.</desc>
                        <defs>
                            <linearGradient id="profit-chart-area" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#91a3ff" stop-opacity="0.25" />
                                <stop offset="100%" stop-color="#91a3ff" stop-opacity="0.015" />
                            </linearGradient>
                            <filter id="profit-chart-glow" x="-30%" y="-30%" width="160%" height="160%">
                                <feGaussianBlur stdDeviation="3" result="glow" />
                                <feMerge><feMergeNode in="glow" /><feMergeNode in="SourceGraphic" /></feMerge>
                            </filter>
                        </defs>
                        @for (var gridline = 1; gridline <= 2; gridline++)
                        {
                            var fraction = gridline / 3m;
                            var y = chartTop + fraction * plotHeight;
                            var value = maximumProfit - fraction * (maximumProfit - minimumProfit);
                            <line class="profit-chart-gridline" x1="@chartLeft.ToString(coordinateFormat)" y1="@y.ToString(coordinateFormat)" x2="@(chartWidth - chartRight).ToString(coordinateFormat)" y2="@y.ToString(coordinateFormat)" />
                            <foreignObject x="0" y="@(y - 8).ToString(coordinateFormat)" width="@(chartLeft - 12).ToString(coordinateFormat)" height="18">
                                <span xmlns="http://www.w3.org/1999/xhtml" class="profit-chart-axis-label">@((long)value).ToGroupedDigits()</span>
                            </foreignObject>
                        }
                        <line class="profit-chart-axis" x1="@chartLeft.ToString(coordinateFormat)" y1="@chartTop.ToString(coordinateFormat)" x2="@chartLeft.ToString(coordinateFormat)" y2="@(chartTop + plotHeight).ToString(coordinateFormat)" />
                        <line class="profit-chart-axis" x1="@chartLeft.ToString(coordinateFormat)" y1="@(chartTop + plotHeight).ToString(coordinateFormat)" x2="@(chartWidth - chartRight).ToString(coordinateFormat)" y2="@(chartTop + plotHeight).ToString(coordinateFormat)" />
                        <text class="profit-chart-y-axis-title" transform="translate(18 170) rotate(-90)">Net profit / loss (IRR)</text>
                        <line class="profit-chart-zero" x1="@chartLeft.ToString(coordinateFormat)" y1="@zeroLineY.ToString(coordinateFormat)" x2="@(chartWidth - chartRight).ToString(coordinateFormat)" y2="@zeroLineY.ToString(coordinateFormat)" />
                        @if (points.Count > 1)
                        {
                            var areaPoints = $"{points[0].X.ToString("0.##", coordinateFormat)},{zeroLineY.ToString("0.##", coordinateFormat)} {linePoints} {points[^1].X.ToString("0.##", coordinateFormat)},{zeroLineY.ToString("0.##", coordinateFormat)}";
                            <polygon class="profit-chart-area" points="@areaPoints" />
                            <polyline class="profit-chart-line" pathLength="1" points="@linePoints" />
                        }
                        else if (points.Count == 1)
                        {
                            <line class="profit-chart-line" pathLength="1" x1="@chartLeft.ToString(coordinateFormat)" y1="@zeroLineY.ToString(coordinateFormat)" x2="@(chartWidth - chartRight).ToString(coordinateFormat)" y2="@zeroLineY.ToString(coordinateFormat)" />
                        }
                        @for (var index = 0; index < points.Count; index++)
                        {
                            var point = points[index];
                            <circle class="profit-chart-point" style="--point-delay: @(Math.Min(index, 30) * 20)ms" cx="@point.X.ToString("0.##", coordinateFormat)" cy="@point.Y.ToString("0.##", coordinateFormat)" r="4">
                                <title>@FormatPeriod(point.Period): @point.Profit.ToIrr()</title>
                            </circle>
                            @if (index % chartLabelStep == 0 || index == points.Count - 1)
                            {
                                <g>
                                    <text class="profit-chart-month-label" x="@point.X.ToString("0.##", coordinateFormat)" y="@(chartHeight - 25).ToString(coordinateFormat)" text-anchor="middle">@FormatPeriod(point.Period)</text>
                                </g>
                            }
                        }
                        <text class="profit-chart-x-axis-title" x="@((chartLeft + plotWidth / 2m).ToString(coordinateFormat))" y="@(chartHeight - 5).ToString(coordinateFormat)" text-anchor="middle">@Model.TrendInterval</text>
                    </svg>
                </div>
                <div class="profit-chart-legend"><span aria-hidden="true"></span> Net profit / loss</div>
        </section>
        <table class="table table-striped"><thead><tr><th>Product</th><th>Bought (IRR)</th><th>Sold (IRR)</th><th>Profit / loss (IRR)</th><th>By percent</th></tr></thead><tbody>
@foreach (var row in Model.Rows)
{
    var profitClass = row.Profit >= 0 ? "text-success" : "text-danger";
    <tr><td>@row.ProductLabel</td><td>@row.Bought.ToIrr()</td><td>@row.Sold.ToIrr()</td><td class="@profitClass">@row.Profit.ToIrr()</td><td class="@profitClass">@row.ProfitPercent.ToString("F2")%</td></tr>
}
</tbody></table>
    </div>

    <div class="tab-pane fade" id="distribution" role="tabpanel">
        <p class="lead">Total profit (IRR): <strong><span class="@(Model.TotalProfit >= 0 ? "text-success" : "text-danger")">@(Model.TotalProfit > 0 ? "+" : "")@Model.TotalProfit.ToGroupedDigits()</span></strong></p>
        <table class="table table-striped"><thead><tr><th>Employee</th><th>Share %</th><th>Amount (IRR)</th></tr></thead><tbody>
@foreach (var row in Model.DistributionRows)
{
    <tr class="@(row.IsLossPeriod ? "table-danger" : "")">
        <td>@row.EmployeeName</td>
        <td>@row.SharePercent%</td>
        <td>@row.CalculatedAmount.ToGroupedDigits()</td>
    </tr>
}
</tbody></table>
    </div>
</div>
