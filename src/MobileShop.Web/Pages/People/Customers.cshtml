@page
@model MobileShop.Web.Pages.People.CustomersModel
@{ ViewData["Title"] = "Customers"; }
<h1>Customers</h1>
<table class="table table-striped"><thead><tr><th>Name</th><th>Phone</th><th>National ID</th><th></th></tr></thead><tbody>
@foreach (var customer in Model.Customers)
{ <tr><td>@customer.PersonNavigation.FirstName @customer.PersonNavigation.LastName</td><td>@customer.PersonNavigation.PhoneNumber</td><td>@customer.NationalId</td><td><a asp-page="/People/CustomerDetails" asp-route-id="@customer.Id">Details</a></td></tr> }
</tbody></table>
