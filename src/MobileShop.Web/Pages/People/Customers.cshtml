@page
@model MobileShop.Web.Pages.People.CustomersModel
@{ ViewData["Title"] = "Customers"; }
<h1>Customers</h1>
<div class="mb-3">
    <a asp-page="/People/CreateCustomer" class="btn btn-success">Add customer</a>
</div>
<table class="table table-striped"><thead><tr><th>Name</th><th>Phone</th><th>National ID</th><th></th></tr></thead><tbody>
@foreach (var customer in Model.Customers)
{ <tr><td>@customer.Name</td><td>@customer.PhoneNumber</td><td>@customer.NationalId</td><td><a asp-page="/People/CustomerDetails" asp-route-id="@customer.Id">Details</a></td></tr> }
</tbody></table>
