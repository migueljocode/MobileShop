@page
@model MobileShop.Web.Pages.People.CreateSellerModel
@{
    ViewData["Title"] = "Create seller";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Create seller</h1>
    </div>
</div>

<form method="post" class="row g-3 col-lg-6 mx-auto">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-section col-12">
        <h2 class="form-section__title">Name</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.FirstName" class="form-label"></label>
                <input asp-for="Input.FirstName" class="form-control" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.LastName" class="form-label"></label>
                <input asp-for="Input.LastName" class="form-control" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-section col-12">
        <h2 class="form-section__title">Contact</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <input asp-for="Input.PhoneNumber" class="form-control" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.EntityType" class="form-label"></label>
                <select asp-for="Input.EntityType" asp-items="Html.GetEnumSelectList<SellerEntityType>()" class="form-select"></select>
                <span asp-validation-for="Input.EntityType" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-section col-12">
        <h2 class="form-section__title">Notes</h2>
        <div class="col-12">
            <label asp-for="Input.Notes" class="form-label"></label>
            <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Notes" class="text-danger"></span>
        </div>
    </div>

    <div class="action-bar col-12">
        <button class="btn btn-primary" type="submit">Save seller</button>
        <a asp-page="/People/Index" asp-route-type="sellers" class="btn btn-outline-secondary">Back to sellers</a>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-danger mt-3">@Model.Message</div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
