@page
@model MobileShop.Web.Pages.People.SellersModel
@{ ViewData["Title"] = "Sellers"; }
<h1>Sellers</h1>
<table class="table table-striped"><thead><tr><th>Name</th><th>Phone</th><th>Type</th><th></th></tr></thead><tbody>
@foreach (var seller in Model.Sellers)
{ <tr><td>@seller.PersonNavigation.FirstName @seller.PersonNavigation.LastName</td><td>@seller.PersonNavigation.PhoneNumber</td><td>@seller.EntityType</td><td><a asp-page="/People/SellerDetails" asp-route-id="@seller.Id">Details</a></td></tr> }
</tbody></table>
