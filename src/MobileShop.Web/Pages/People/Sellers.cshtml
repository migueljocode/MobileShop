@page
@model MobileShop.Web.Pages.People.SellersModel
@{ ViewData["Title"] = "Sellers"; }
<div class="page-head">
    <div>
        <h1 class="page-head__title">Sellers</h1>
    </div>
    <div class="page-head__actions">
        <a asp-page="/People/CreateSeller" class="btn btn-success">Add seller</a>
    </div>
</div>
@if (!Model.Sellers.Any())
{
    <partial name="_EmptyState" model='("No sellers yet", "Add the first seller to get started.")' />
}
else
{
    <div class="table-responsive">
    <table class="data-table"><thead><tr>
    <th scope="col" aria-sort="@(Model.SortBy == "Name" ? (Model.Ascending ? "ascending" : "descending") : "none")">
        <a asp-route-sortBy="Name" asp-route-ascending="@(Model.SortBy == "Name" && Model.Ascending ? "false" : "true")">
            Name
            @if (Model.SortBy == "Name")
            {
                <span aria-hidden="true">@(Model.Ascending ? "↑" : "↓")</span>
            }
        </a>
    </th>
    <th scope="col" aria-sort="@(Model.SortBy == "Phone" ? (Model.Ascending ? "ascending" : "descending") : "none")">
        <a asp-route-sortBy="Phone" asp-route-ascending="@(Model.SortBy == "Phone" && Model.Ascending ? "false" : "true")">
            Phone
            @if (Model.SortBy == "Phone")
            {
                <span aria-hidden="true">@(Model.Ascending ? "↑" : "↓")</span>
            }
        </a>
    </th>
    <th scope="col">Type</th>
    <th scope="col" aria-sort="@(Model.SortBy == "Count" ? (Model.Ascending ? "ascending" : "descending") : "none")">
        <a asp-route-sortBy="Count" asp-route-ascending="@(Model.SortBy == "Count" && Model.Ascending ? "false" : "true")">
            Sold
            @if (Model.SortBy == "Count")
            {
                <span aria-hidden="true">@(Model.Ascending ? "↑" : "↓")</span>
            }
        </a>
    </th>
    <th scope="col"><span class="visually-hidden">Actions</span></th>
</tr></thead><tbody>
@foreach (var seller in Model.Sellers)
{ <tr><td dir="auto">@seller.Name</td><td dir="auto" class="num">@seller.PhoneNumber</td><td>@seller.EntityType</td><td>@seller.SoldCount</td><td><a asp-page="/People/SellerDetails" asp-route-id="@seller.Id">Details</a></td></tr> }
</tbody></table>
    </div>
}
<div class="action-bar">
    <a asp-page="/People/Index" class="btn btn-outline-secondary">Back to people</a>
</div>
