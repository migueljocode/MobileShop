@page
@model MobileShop.Web.Pages.People.CustomerDetailsModel
@{ ViewData["Title"] = "Customer details"; }
@if (Model.Customer is not null)
{
    <h1>@Model.Customer.PersonNavigation.FirstName @Model.Customer.PersonNavigation.LastName</h1>
    <p>Phone: @Model.Customer.PersonNavigation.PhoneNumber · National ID: @Model.Customer.NationalId</p>
    <h2>Purchased products</h2>
    @if (Model.Products.Count == 0) { <p class="text-muted">No purchased products.</p> }
    else { <ul>@foreach (var product in Model.Products) { <li>@product.Manufacturer @product.Model (Product #@product.Id)</li> }</ul> }
}
