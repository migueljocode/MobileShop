@page
@model MobileShop.Web.Pages.People.CustomerDetailsModel
@{ ViewData["Title"] = "Customer details"; }
@if (Model.Customer is not null)
{
    <div class="page-head">
        <div>
            <h1 class="page-head__title" dir="auto">@Model.Customer.Name</h1>
            <p class="page-head__sub">Customer</p>
        </div>
        <div class="page-head__actions">
            <a asp-page="/People/EditCustomer" asp-route-id="@Model.CustomerId" class="btn btn-primary">Edit</a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.CustomerId" style="display:inline;" onsubmit="return confirm('Remove this customer?');">
                <button type="submit" class="btn btn-outline-danger">Remove</button>
            </form>
            <a asp-page="/People/Index" asp-route-type="customers" class="btn btn-outline-secondary">Back to customers</a>
        </div>
    </div>
    <div class="form-section">
        <h2 class="form-section__title">Contact</h2>
        <dl class="row">
            <dt class="col-sm-4 text-muted">Phone</dt><dd class="col-sm-8 num" dir="auto">@Model.Customer.PhoneNumber</dd>
            <dt class="col-sm-4 text-muted">National ID</dt><dd class="col-sm-8" dir="auto">@Model.Customer.NationalId</dd>
        </dl>
    </div>
    <div class="form-section">
        <h2 class="form-section__title">Purchased products</h2>
        @if (Model.Products.Count == 0) { <p class="text-muted">No purchased products.</p> }
        else { <ul>@foreach (var product in Model.Products) { <li dir="auto">@product.Name</li> }</ul> }
    </div>
}
