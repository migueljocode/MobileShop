@page
@model MobileShop.Web.Pages.People.PeopleIndexModel
@{ ViewData["Title"] = "People"; }
<div class="page-head">
    <div>
        <h1 class="page-head__title">People</h1>
    </div>
    <div class="page-head__actions">
        @if (Model.ShowAddCustomer)
        {
            <a asp-page="/People/CreateCustomer" class="btn btn-success">Add customer</a>
        }
        else if (Model.ShowAddSeller)
        {
            <a asp-page="/People/CreateSeller" class="btn btn-success">Add seller</a>
        }
    </div>
</div>

<div class="toolbar">
    <form method="get" class="row g-3 align-items-end">
        <fieldset class="col-12 col-lg-auto">
            <legend class="form-label mb-2">Show</legend>
            <div class="segmented">
                <input class="btn-check" type="radio" name="type" id="peopleAll" value="all" checked="@(Model.Type == "all")" onchange="this.form.submit()" />
                <label class="btn" for="peopleAll">All</label>
                <input class="btn-check" type="radio" name="type" id="peopleCustomers" value="customers" checked="@(Model.Type == "customers")" onchange="this.form.submit()" />
                <label class="btn" for="peopleCustomers">Customers</label>
                <input class="btn-check" type="radio" name="type" id="peopleSellers" value="sellers" checked="@(Model.Type == "sellers")" onchange="this.form.submit()" />
                <label class="btn" for="peopleSellers">Sellers</label>
            </div>
        </fieldset>
        <div class="col-12 col-sm-6 col-lg-3">
            <label for="sortBy" class="form-label mb-2">Sort by</label>
            <select class="form-select" id="sortBy" name="sortBy" onchange="this.form.submit()">
                <option value="name" selected="@(Model.SortBy == "Name")">Name</option>
                <option value="phone" selected="@(Model.SortBy == "Phone")">Phone</option>
                <option value="count" selected="@(Model.SortBy == "Count")">@Model.ActivityColumnLabel</option>
            </select>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <label for="ascending" class="form-label mb-2">Direction</label>
            <select class="form-select" id="ascending" name="ascending" onchange="this.form.submit()">
                <option value="true" selected="@Model.Ascending">Ascending</option>
                <option value="false" selected="@(!Model.Ascending)">Descending</option>
            </select>
        </div>
    </form>
</div>

@if (Model.People.Count == 0)
{
    <partial name="_EmptyState" model='("No people yet", "Add the first customer or seller to get started.")' />
}
else
{
    <div class="table-responsive">
    <table class="data-table">
        <thead>
            <tr><th scope="col">Role</th><th scope="col">Name</th><th scope="col">Phone</th><th scope="col">National ID</th><th scope="col">Seller type</th><th scope="col">@Model.ActivityColumnLabel</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
        </thead>
        <tbody>
            @foreach (var person in Model.People)
            {
                <tr>
                    <td>@person.Role</td>
                    <td dir="auto">@person.Name</td>
                    <td dir="auto" class="num">@person.PhoneNumber</td>
                    <td dir="auto">@(person.NationalId ?? "N/A")</td>
                    <td>@(person.EntityType ?? "N/A")</td>
                    <td>@person.ActivityCount</td>
                    <td><a asp-page="@person.DetailsPage" asp-route-id="@person.Id">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
